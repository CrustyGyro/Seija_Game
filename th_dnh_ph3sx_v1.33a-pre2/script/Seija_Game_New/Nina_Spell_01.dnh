	//NotifyEventAll( EV_BOSS_EFFECT, bossObj, CC_PINK );
	//T_Shoot_Banner( "Watari Nina", CC_PINK, 40 );

	wait( 125 );

	T_InitSpell();
	
	wait( 160 );

	ObjEnemy_SetDamageRate( bossObj, 0.16, 0.16 );
	
	//T_Boss_Shot_C;
	
	T_Boss_Shot_B();
	
	wait( 100 );

