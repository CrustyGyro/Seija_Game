#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Prifma_Spell WIP"]
//#Background["./Stage/STG_03/STG_BG.dnh"];
#Player[ "./Player/PL_Reimu.dnh" ]
#System["./System/System_Main_Hud.dnh"]

//--------------------------------------------------Variables------------------------------------------------------

let bossObj;
let objScene = GetEnemyBossSceneObjectID();
let bossX = 0;
let bossY = 0;

int Dir_Switch = 1;

//SetIntersectionVisualization( true );
let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/EGoA_Boss_6.png";

//---------------------------------------------------Include-------------------------------------------------------

	#include "./lib/Index_Boss.dnh"
	#include "./lib/Lib_Spell.dnh"
	#include "./lib/Lib_SpellCutin.dnh"

//----------------------------------------------------Start--------------------------------------------------------

@Loading {
	
    LoadTexture( CutinTex );

}


@Initialize {

	bossObj = ObjEnemy_Create(OBJ_ENEMY_BOSS);	
	
	ObjEnemy_Regist( bossObj );	

	T_Lifebar( bossObj );
	T_HitEffect( bossObj );
	ObjEnemy_SetDamageRate( bossObj, 0, 0 );	

	Init_Boss_Prifma( bossObj );
	
	ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2, Get_CenterY/1.1, 15, 8 );
	
	
	SetPlayerLife( 8 );
	T_Main;
	T_End;
	
}

@Event { 

	alternative(GetEventType()) 
	case( EV_REQUEST_LIFE ) { 
		SetScriptResult( 1000 ); // 3000-4500 For Nons ( At 100% Damage Rate. )
	}
	case( EV_REQUEST_TIMER ) { 
		//SetScriptResult( 50 );
		SetScriptResult( 70 );
	}	
	case( EV_REQUEST_SPELL_SCORE ){
       SetScriptResult( 15000000 );
    }	

} 

@MainLoop {

	bossX = ObjMove_GetX( bossObj );
	bossY = ObjMove_GetY( bossObj );
	
	SetCommonData( "Effect_X", bossX );
	SetCommonData( "Effect_Y", bossY );	

	ObjEnemy_SetIntersectionCircleToShot( bossObj, bossX, bossY, 16 );
	ObjEnemy_SetIntersectionCircleToPlayer( bossObj, bossX, bossY, 8 );
	
	yield;
}

@Finalize {
} 


task T_InitSpell(){
	
	//let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/CurseOfRa.png";
	
	T_CallSpell_A1( "\"Samsara Ferris Wheel ( WIP )\"", 0, "Normal", objScene );
	T_Call_Spell_Cutin( CutinTex, [ 0, 0, 445, 854 ], 0.5, CC_CYAN );	
	
	ObjEnemyBossScene_StartSpell( objScene );
	
	yield;
	T_SpellBG_Prifma();
	
}	


//----------------------------------------------------Patterns--------------------------------------------------------

task T_Main {


	NotifyEventAll( EV_BOSS_EFFECT, bossObj, CC_GREEN );
	T_Shoot_Banner( "Amanowara no Nijie", CC_CYAN, 40 );

	wait( 125 );

	T_InitSpell();
	
	wait( 160 );

	ObjEnemy_SetDamageRate( bossObj, 0.1, 0.2 );
	
	//T_Boss_Shot_C;
	
	T_Boss_Shot_A();
	
	wait( 100 );
	T_Boss_Shot_D();
	//T_Movement_A( bossObj );
	
}	

task T_Movement_A( Obj ){

	let X = 0;
	let Y = 0;
	
	while( !Obj_IsDeleted( Obj ) ){

		ObjMove_SetDestAtWeight( Obj, bossX + 16 * cos( X ), bossY + 16 * sin( Y ), 64, 3 );
		X += 1;
		Y += 1;
		
		yield;
	}

}

task T_Boss_Shot_D{
	
	//float Frame = 0;
	
	wait( 260 );
	
	while( !Obj_IsDeleted( bossObj ) ){
	
		ascent( i in 0..10 ){
			
			int Dummy_Shot_Core =  ShotA1( bossX, bossY, 0.5, GetAngleToPlayer( bossObj ) + i * 360/10, SHOT_LARGE_STAR_GREY, 10 );

	
		}
		
		//Frame+= 4;
		wait( 160 );
	}
	
}	

task T_Boss_Shot_A{
	
	int Way = 12;
	int Stack = 1;
	
	//Horribleness--
	int[] Shot_Color = [ SHOT_LASER_RED, SHOT_LASER_ORANGE, SHOT_LASER_YELLOW, SHOT_LASER_GREEN, SHOT_LASER_MINT, SHOT_LASER_AQUA, SHOT_LASER_BLUE, SHOT_LASER_PURPLE, SHOT_LASER_MAGENTA, SHOT_LASER_PINK, SHOT_LASER_DPINK, SHOT_LASER_GREY ];
	int[] Shot_Color_Sub = [ SHOT_BALL_AURA_RED, SHOT_BALL_AURA_ORANGE, SHOT_BALL_AURA_YELLOW, SHOT_BALL_AURA_GREEN, SHOT_BALL_AURA_MINT, SHOT_BALL_AURA_AQUA, SHOT_BALL_AURA_BLUE, SHOT_BALL_AURA_PURPLE, SHOT_BALL_AURA_MAGENTA, SHOT_BALL_AURA_PINK, SHOT_BALL_AURA_PINK, SHOT_BALL_AURA_GREY ];
	
	int Dummy_Shot_Core =  ShotA1( bossX, bossY, 0, 90, SHOT_ORB_AQUA, 10 );
	ObjShot_SetSpellResist( Dummy_Shot_Core, true );
	T_Movement_A( Dummy_Shot_Core );
	
	int[] Dummy_Shots = Pattern_Shot_A1( bossX, bossY, 0, 32, 360, 0, SHOT_CLOUD_AZURE, PATTERN_RING, Way, Stack, 0, SHOT_CLOUD_AZURE );
	int[] Dummy_Shots_Middle = Pattern_Shot_A1( bossX, bossY, 0, 32, 360, 0, SHOT_CLOUD_AZURE, PATTERN_RING, Way, Stack, 0, SHOT_CLOUD_AZURE );
	int[] Dummy_Shots_Outer = Pattern_Shot_A1( bossX, bossY, 0, 32, 360, 0, SHOT_CLOUD_AZURE, PATTERN_RING, Way, Stack, 0, SHOT_CLOUD_AZURE );
	
	for( int a = 0; a < Way * Stack; a++ ) {
		
		// HELL WORLD HELL WORLD
		T_Manage_Pyramid( Dummy_Shot_Core, Dummy_Shots[a], 156, 90, 200, -0.2 );
		T_Manage_Pyramid( Dummy_Shot_Core, Dummy_Shots_Outer[a], 256, -90, 300, -0.1 );
		T_Manage_Pyramid( Dummy_Shot_Core, Dummy_Shots_Middle[a], 280, -90, 300, 0.1 );
		
		T_Manage_Shot_Inner( Dummy_Shots[a] );
		if( a < Way-1 ){
				
			T_Manage_Laser( Dummy_Shots[a], Dummy_Shots[a+1], true, false, Shot_Color[a], Shot_Color_Sub[a] );
			T_Manage_Laser( Dummy_Shots_Outer[a], Dummy_Shots_Outer[a+1], false, true, Shot_Color[a], Shot_Color_Sub[a]  );
			
			T_Manage_Laser( Dummy_Shots_Middle[a], Dummy_Shots_Middle[a+1], false, true, Shot_Color[a], Shot_Color_Sub[a]  );
			
		}
		else{
				
			T_Manage_Laser( Dummy_Shots[Way-1], Dummy_Shots[0], true, false, Shot_Color[a], Shot_Color_Sub[a]  );
			T_Manage_Laser( Dummy_Shots_Outer[Way-1], Dummy_Shots_Outer[0], false, true,Shot_Color[a], Shot_Color_Sub[a]  );
			
			T_Manage_Laser( Dummy_Shots_Middle[Way-1], Dummy_Shots_Middle[0], false, true, Shot_Color[a], Shot_Color_Sub[a]  );

		}			

	}
	
	task T_Manage_Shot_Inner( Shot ){
		
		wait( 200 );
		while( !Obj_IsDeleted( Shot ) ){
		
			int Shot_A = ShotA1( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 1, ObjMove_GetAngle( Shot ) -180 + 45, SHOT_ICE_AZURE, 10 );
			//ObjShot_SetDeleteFrame( Shot_A, 160 );
		
			wait( 24 );
		}
	}	
	
	task T_Manage_Laser( Shot, Next_Shot, PermitExpand, Can_Shoot, Color, Sub_Shot_Color ){
			
		//int Prism = Create_Famliar_A1( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), GHOST_S_NORMAL, ENEMY_RED, 1000, false, 1, 1, 400 );		
		let Connector = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 0, 16, 99999, Color, 200 );
		let Prifma_Connector = CreateStraightLaserA1( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 0, 16, 99999, Color, 200 );
		ObjStLaser_SetPermitExpand( Prifma_Connector, PermitExpand );
		
		//ObjRender_SetAlpha( Shot, 0 );
		//ObjRender_SetAlpha( Next_Shot, 0 );
		
		ObjShot_SetSpellResist( Shot, true );
		ObjShot_SetAutoDelete( Shot, false );		
		ObjShot_SetAutoDelete( Connector, false );		
		ObjStLaser_SetSource( Connector, false );
		ObjStLaser_SetSource( Prifma_Connector, false );

		if( Can_Shoot == true ){	
			async{	
			
				int Shot_Count = 1;
			
				wait( 60 );
			
				while( !Obj_IsDeleted( Shot ) ){
					
					ascent( i in 0..Shot_Count ){
						int Shot_A = ShotA1( ObjMove_GetX( Prifma_Connector ), ObjMove_GetY( Prifma_Connector ), 0, ObjMove_GetAngle( Prifma_Connector ), Sub_Shot_Color, 8 );
						
						T_Manage_Shot( Shot_A );
						
						wait( 8 );
						
					}	
					
					wait( 60 );
				}				
					
			}	
		}
		
		task T_Manage_Shot( Shot_A ){
					
			//ObjShot_SetSpellResist( Shot_A, true );
			ObjShot_SetAutoDelete( Shot_A, false );	
			ObjRender_SetBlendType( Shot_A, BLEND_ADD_ARGB );

			float Shot_Time = 400; //The time it takes it to go along the whole laser.
					
			while( !Obj_IsDeleted( Shot_A ) ){
						
				ascent( i in 0..Shot_Time ){
					let L_Length = ObjLaser_GetLength( Prifma_Connector ) * i/Shot_Time;
					let L_Angle = ObjStLaser_GetAngle( Prifma_Connector );
					
					//ObjRender_SetColor( Shot_A, 255- i * 255/Shot_Time, 255 - i * 255/Shot_Time, 255 );
					ObjMove_SetAngle( Shot_A, L_Angle );
					ObjMove_SetPosition( Shot_A, ObjMove_GetX( Prifma_Connector ) + L_Length *cos( L_Angle ), ObjMove_GetY( Prifma_Connector ) + L_Length *sin( L_Angle ) );
								
					yield;
					
				}
				
				Obj_Delete( Shot_A );
			}
					
		}	
		
		while( !Obj_IsDeleted( Shot ) || !Obj_IsDeleted( Next_Shot ) ){

						
			if( Obj_IsDeleted( Next_Shot ) ){ break; }
			if( Obj_IsDeleted( Shot ) ){ break; }
			
			
			//ObjMove_SetPosition( Prism, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
			ObjMove_SetPosition( Prifma_Connector, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
			ObjStLaser_SetAngle( Prifma_Connector, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Dummy_Shot_Core ), ObjMove_GetY( Dummy_Shot_Core ) ) );
			ObjLaser_SetLength( Prifma_Connector, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Dummy_Shot_Core ), ObjMove_GetY( Dummy_Shot_Core ) ) + 1 );							
									
			ObjMove_SetPosition( Connector, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
			ObjStLaser_SetAngle( Connector, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) );
			ObjLaser_SetLength( Connector, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) + 1 );	
						
			yield;
		}
		Obj_Delete( Connector );
		Obj_Delete( Prifma_Connector );
		
	}	
	
	task T_Manage_Pyramid( Parent, Shot, Radius, Initial_Angle, Time, Dir ){
			
		async{
				
			float Angle = dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Parent ), ObjMove_GetY( Parent ) );
			float Frame = 0;
			float Inital_Radius = 0;
			float Angle_Init = Initial_Angle;
				
			ascent( i in 0..Time ){
					
				float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle );
				float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle );					
								
					//Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
				Inital_Radius = Interpolate_Overshoot( 0, Radius, 1.5, i/Time );

				Angle+= Dir;	
									
				ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
				ObjMove_SetAngle( Shot, Angle );
					
				yield;
					
			}	

				
			while( !Obj_IsDeleted( Parent ) ){
					
				float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle );
				float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle );					
					
				Angle+= Dir;		
					//Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
				//Inital_Radius = Interpolate_Overshoot( 0, Radius, 2, i/Time );				
									
				ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
				ObjMove_SetAngle( Shot, Angle );
					
				yield;
					
			}	
			
			Obj_Delete( Shot );
		
		}
			
	}	
	
	
}	

task T_Boss_Shot_C{
	
	float Angle_I = 90;
	int Count_X = 3;
	int Count_Y = 3;
	int Shot_go = -1;
	int Delay_Pyramid = 500;
	
	//A mess....
	
	int[] Laser_Color = [ SHOT_LASER_YELLOW, SHOT_LASER_BLUE, SHOT_LASER_YELLOW, SHOT_LASER_BLUE, SHOT_LASER_YELLOW, SHOT_LASER_BLUE ];
	int[] Connector_Color = [ SHOT_CLOUD_YELLOW, SHOT_CLOUD_BLUE, SHOT_CLOUD_YELLOW, SHOT_CLOUD_BLUE, SHOT_CLOUD_YELLOW, SHOT_CLOUD_BLUE ];
	int[] Core_Color = [ SHOT_ORB_YELLOW, SHOT_ORB_BLUE, SHOT_ORB_YELLOW, SHOT_ORB_BLUE, SHOT_ORB_YELLOW, SHOT_ORB_BLUE ];
	int[] Shot_Color = [ SHOT_DIAMOND_INVERT_DYELLOW, SHOT_DIAMOND_INVERT_BLUE, SHOT_DIAMOND_INVERT_DYELLOW, SHOT_DIAMOND_INVERT_BLUE, SHOT_DIAMOND_INVERT_DYELLOW, SHOT_DIAMOND_INVERT_BLUE ];
	
	if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
		T_Charge_A1( bossObj, 32, "Maple", CC_ORANGE );
		T_PlaySE( SE_CHARGE_00, 35 );		
	}			
	
	wait( 100 );
	
	while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
		ascent( X in 0..Count_X ){

			ascent( Y in 0..Count_Y ){
				
				if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
					T_PlaySE( SE_CHIME_01, 36 );
					
					T_Create_Pyramid_A( 40 + X * Get_MaxX/Count_X, 40 + Y * Get_MaxY/Count_Y, Angle_I, 40, ( Y + X ) * 8*2, Shot_go, Laser_Color[ Y ], Connector_Color[ Y ], Core_Color[ Y ], Shot_Color[ Y ] );
					
					Angle_I = -Angle_I;	
				
					wait( 8 );
				}
			}
		}	

		wait( 900 );

		Shot_go = -Shot_go;	
		ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2 + rand( -32, 32 ), Get_CenterY/2 + 16 + rand( -8, 8 ), 16, 1 );	
		
		wait( Delay_Pyramid );
		
		if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
			T_Charge_A1( bossObj, 32, "Maple", CC_ORANGE );
			T_PlaySE( SE_CHARGE_00, 35 );		
		}			
			
		wait( 100 );
		
		//Angle_I = -Angle_I;
		
		ascent( X in 0..Count_X ){

			ascent( Y in 0..Count_Y ){
				
				if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
				
					T_PlaySE( SE_CHIME_01, 36 );
					
					T_Create_Pyramid_A( Get_MaxX - 40 - X * Get_MaxX/Count_X, 40 + Y * Get_MaxY/Count_Y, Angle_I, 40, ( Y + X ) * 8*2, Shot_go, Laser_Color[ Y ], Connector_Color[ Y ], Core_Color[ Y ], Shot_Color[ Y ] );
					
					Angle_I = -Angle_I;
					
					wait( 8 );
				}
			}
		}	

		wait( 900 );

		Shot_go = -Shot_go;	
		ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2 + rand( -32, 32 ), Get_CenterY/2 + 16 + rand( -8, 8 ), 16, 1 );			
		
		wait( Delay_Pyramid );
		
		if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
			T_Charge_A1( bossObj, 32, "Maple", CC_ORANGE );
			T_PlaySE( SE_CHARGE_00, 35 );		
		}			
			
		wait( 100 );
		
		//Angle_I = -Angle_I;
		
		yield;


	}
	
	task T_Create_Pyramid_A( X, Y, Init_Angle, Radius, ID, Go_Status, Laser_Color, Connector_Color, Core_Color, Shot_Color ){

		float Delay = 0;
		int Way = 3;
		int Stack = 8;	
		
		int ShotObj_Core = ShotA1( X, Y, 0, 90, Connector_Color, 10 );
		int[] Laser_Connector = Pattern_Shot_A1( X, Y, 0, 128, Init_Angle, 1, SHOT_BALL_YELLOW, PATTERN_POLYGON, Way, Stack, 10, SHOT_BALL_YELLOW );
		
		ObjRender_SetAlpha( ShotObj_Core, 1 );
		
		for( int i = 0; i < Way * Stack; i++ ) {
			
			T_Manage_Pyramid( ShotObj_Core, Laser_Connector[i] );
			ObjRender_SetBlendType( Laser_Connector[i], BLEND_ADD_ARGB  );
			/*
			if( i < Way-1 ){
				
				T_Manage_Laser( Laser_Connector[i], Laser_Connector[i+1] );
			}
			else{
				
				T_Manage_Laser( Laser_Connector[Way-1], Laser_Connector[0] );

			}	
			*/
			//yield;
		}
		
		task T_Manage_Laser( Shot, Next_Shot ){
			
			let Connector = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 0, 16, 99999, Laser_Color, 80 );
			ObjRender_SetAlpha( Connector, 0 );
			ObjStLaser_SetSource( Connector, false );
			
			async{
				
				yield;
				
				ObjRender_SetAlpha( Connector, 255 );
				
				while( !Obj_IsDeleted( Shot ) || !Obj_IsDeleted( Next_Shot ) ){

						
					if( Obj_IsDeleted( Next_Shot ) ){ break; }
					if( Obj_IsDeleted( Shot ) ){ break; }
			
						
					ObjMove_SetPosition( Connector, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
					ObjStLaser_SetAngle( Connector, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) );
					ObjLaser_SetLength( Connector, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) + 1 );	
						
					yield;
				}
				Obj_Delete( Connector );
				
			}	
			
			async{
				
				//wait( 200 - ID );
				while( Shot_go == Go_Status ){ yield; }
				
				float Laser_Angle = ObjStLaser_GetAngle( Connector );
				float[] Shot_Speed = [ 0.2, 0.25, 0.25, 0.2, 0.1, 0.1, 0.1 ];
				
				T_PlaySE( SE_CHIME_00, 36 );
				
				if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
					ascent( a in 0..4 ){
						
						float Shot_X = ObjMove_GetX( Connector ) + a * ObjLaser_GetLength( Connector )/4 * cos( Laser_Angle );
						float Shot_Y = ObjMove_GetY( Connector ) + a * ObjLaser_GetLength( Connector )/4 * sin( Laser_Angle );
						
						int ShotObj_A = ShotA2( Shot_X, Shot_Y, 0, ObjStLaser_GetAngle( Connector ) - 90, Shot_Color, 20, Shot_Color );
						int ShotObj_B = ShotA2( Shot_X, Shot_Y, 0, ObjStLaser_GetAngle( Connector ) - 90, SHOT_BALL_AURA_DYELLOW, 1, SHOT_CLOUD_YELLOW );
						
						ObjShot_SetDeleteFrame( ShotObj_B, 24 );
						Obj_SetRenderPriorityI( ShotObj_B, Obj_GetRenderPriorityI( ShotObj_B )+1 );
						ObjRender_SetBlendType( ShotObj_B, BLEND_ADD_ARGB  );
						
						ObjMove_AddPatternA2( ShotObj_A, 80, NO_CHANGE, NO_CHANGE, 0.01, 0.1 + Shot_Speed[a], 0 );
						//ObjMove_AddPatternA2( ShotObj_A, 30, NO_CHANGE, NO_CHANGE, 0.01, 0.3 - a/8 * sin( a*2 ), 0 );
						//ObjMove_AddPatternA2( ShotObj_A, 160, NO_CHANGE, NO_CHANGE, 0.01, 1 - a/8 * sin( a*2 ), 0 );

					}
				}				
				
				Obj_Delete( Shot );
				Obj_Delete( Next_Shot );
				Obj_Delete( Connector );		

				async{
					//wait( 200 + ID*5.5 );
					
					wait( 160 + ID );
					
					if( !Obj_IsDeleted( ShotObj_Core ) ){
						
						T_PlaySE( SE_LASER_03, 36 );
						
						//int Aimed_ShotObj_A = ShotA2( ObjMove_GetX( ShotObj_Core ), ObjMove_GetY( ShotObj_Core ), 0.5, GetAngleToPlayer( ShotObj_Core ), SHOT_ORB_YELLOW, 20, SHOT_ORB_YELLOW );
						ascent( c in 0..4 ){
							
							let Aimed_Laser = Laser_A1( ObjMove_GetX( ShotObj_Core ), ObjMove_GetY( ShotObj_Core ), 45 - c * 360/4, 512, 8, 60, Laser_Color, 60 );
							ObjStLaser_SetSource( Aimed_Laser, false );
							
						}	
						//let Aimed_Laser = CreateStraightLaserA1( ObjMove_GetX( ShotObj_Core ), ObjMove_GetY( ShotObj_Core ), GetAngleToPlayer( ShotObj_Core ), 512, 24, 20, SHOT_LASER_YELLOW, 30 );
						
						async{
							
							wait( 60 );
							
							ObjShot_SetIntersectionEnable( ShotObj_Core, false );
							
							T_PlaySE( SE_LASER_00, 36 );
							
							ascent( a in 0..60 ){
								ObjRender_SetScaleXYZ( ShotObj_Core, 1 - a * 1/60, 1 - a * 1/60, 1 - a * 1/60 );
								yield;
							}
							
							Obj_Delete( ShotObj_Core );
							
						}	
						
						//wait( 180 );
						
						//Obj_Delete( ShotObj_Core );
					}
				}	
				
			}	
			
		}	

		task T_Manage_Pyramid( Parent, Shot ){
			
			yield;
			
			async{
				
				float Angle = 0.5;
				float Frame = 0;
				float Rotation_Radius = 0;
			//	float Angle_Init = Init_Angle;
				
				//ill update this later...
				
				while( true ){
					
					float X_Pos = ObjMove_GetX( Parent ) + Rotation_Radius + ( ObjMove_GetX( Shot ) - ObjMove_GetX( Parent ) ) * cos( Angle ) - ( ObjMove_GetY( Shot ) - ObjMove_GetY( Parent ) ) * sin( Angle );
					float Y_Pos = ObjMove_GetY( Parent ) + Rotation_Radius + ( ObjMove_GetX( Shot ) - ObjMove_GetX( Parent ) ) * sin( Angle ) + ( ObjMove_GetY( Shot ) - ObjMove_GetY( Parent ) ) * cos( Angle );					
								
					ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
					//ObjMove_SetAngle( Shot, Angle );
					
					yield;
					
				}				
				
			}
			
		}	

	}		
	
	yield;
	
}	

task T_Boss_Shot_B{
	
	int ShotAngle = 0;
	int SubShot_Angle = 24;

	async{
		
		while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
			
			if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){
				ascent( a in 0..10 ){

					ascent( b in 0..2 ){	
					
						T_PlaySE( SE_CHIME_02, 35 );
						int ShotObj_A = ShotA1( bossX + rand( -16, 16 ) , bossY + rand( -16, 16 )- 64, 3, ( 90 + a * 360/10 ) + ShotAngle, SHOT_DOT_DORANGE, 10 );
							//int ShotObj_A = ShotA1( bossX, bossY - 64, 2.4, ( 90 + a * 360/10 ) + ShotAngle, SHOT_DOT_DORANGE, 10 );
						ObjMove_AddPatternA2( ShotObj_A, 60, NO_CHANGE, NO_CHANGE, -0.08, 0, 0 );
						ObjMove_AddPatternA2( ShotObj_A, 90, NO_CHANGE, ObjMove_GetAngle( ShotObj_A ) + SubShot_Angle, 0.01, rand( 0.5, 2 ), 0 );
							
						//ObjRender_SetBlendType( ShotObj_A, BLEND_ADD_ARGB  );
						SubShot_Angle = -SubShot_Angle;
					}	//yield;
					
				}	
			}
			
			ShotAngle +=10;
			
			wait( 15 );
		}
	}	
}
//-----------------------------------------------------Death---------------------------------------------------------

task T_End {
	
    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
	     yield;
	}
	
	if( ObjEnemyBossScene_GetInfo( GetEnemyBossSceneObjectID, INFO_IS_LAST_STEP ) ){

		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		
		yield;
		
		SetAutoDeleteObject(true);
		T_Boss_Shotdown( bossObj, "Petal", CC_CYAN );
		wait( 200 );
		
		Obj_Delete( bossObj );	
		
		//lol
		ENEMY_CLEAR = true;
		
		yield;
		
		ENEMY_CLEAR = false;
		
		wait( 800 );
		
		CloseScript( GetOwnScriptID() );
		
	}	
	else{
	
	
		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		//DeleteShotAll( TYPE_ALL, TYPE_ITEM );
		
		yield;
		
		SetAutoDeleteObject( true );
		
		Obj_Delete( bossObj );	
		
		wait( 60 );
		
		//DeleteShotAll(TYPE_ALL, TYPE_ITEM);
		
		CloseScript( GetOwnScriptID() );
	
	}
	
	//SetAutoDeleteObject(true);
	
	//Obj_Delete( bossObj );	
	//CloseScript( GetOwnScriptID() );
	
}

