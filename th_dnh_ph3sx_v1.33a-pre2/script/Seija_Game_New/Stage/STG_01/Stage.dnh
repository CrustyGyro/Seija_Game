task T_Wave_A{

    float Spawn_X = -24;
    float Enemy_Angle = -360;
    float Enemy_Speed = 2;
    float Enemy_Wvel = -0.4;

    int Spawn_Rate = 20;

    async{

        wait( 120 );
        ascent (i in 0..4) {

            if( i % 2 == 0 ){
            T_Aimed_Fiary_A1( GetStgFrameWidth()/2 + 64 + i * 128/4, GetStgFrameHeight/2, 90, 3, 0.4, ENEMY_BLUE, SHOT_RICE_RED );
            }
            else{
            T_Aimed_Fiary_A1( GetStgFrameWidth()/2 + 64 + i * 128/4, GetStgFrameHeight/2, 90, 3, 0.4, ENEMY_RED, SHOT_RICE_BLUE );

            }
            //T_Aimed_Fiary_A1( GetStgFrameWidth()/2 - 64 - i * 128/4, GetStgFrameHeight/2, 90, 3, 0.3, ENEMY_BLUE, SHOT_BALL_RED );

            wait( 20 );
        }

    }

    loop (2) {

        // do something
       // T_Fan_Fairy_A( Spawn_X, GetStgFrameHeight/2 - 16, Enemy_Angle, Enemy_Speed - 0.3, Enemy_Wvel, ENEMY_BLUE, SHOT_SCALE_MINT );

        wait( 20 );

        async {
            
            ascent (i in 0..3) {

                T_Popcorn_Fairy_A1( Spawn_X, GetStgFrameHeight()/2 - 32, Enemy_Angle, Enemy_Speed-0.5, Enemy_Wvel, ENEMY_RED, SHOT_BALL_RED, false );

                wait( Spawn_Rate );

                T_Popcorn_Fairy_A1( Spawn_X, GetStgFrameHeight()/2 - 32, Enemy_Angle, Enemy_Speed-0.5, Enemy_Wvel, ENEMY_BLUE, SHOT_BALL_RED, false );

                wait( Spawn_Rate );

            }      
        

          //  T_AimedFairy_A( Spawn_X, GetStgFrameHeight()/2 -32, Enemy_Angle, Enemy_Speed-0.5, Enemy_Wvel, ENEMY_BLUE, SHOT_RICE_DORANGE );

            
        }

        ascent (i in 0..3) {

            T_Popcorn_Fairy_A1( Spawn_X, GetStgFrameHeight()/2, Enemy_Angle, Enemy_Speed, Enemy_Wvel, ENEMY_RED, SHOT_BALL_RED, false );

            wait( Spawn_Rate );

            T_Popcorn_Fairy_A1( Spawn_X, GetStgFrameHeight()/2, Enemy_Angle, Enemy_Speed, Enemy_Wvel, ENEMY_BLUE, SHOT_BALL_RED, false );

            wait( Spawn_Rate );

        }

        Spawn_X = GetStgFrameWidth() + 24;
        Enemy_Angle = 180;
        Enemy_Wvel = -Enemy_Wvel;

        wait( 60 );

    } 
    

    T_Wave_B();


}	
	

task T_Wave_B() {

    T_Popcorn_Fairy_A2( -24, GetStgFrameHeight()/2.6, -360, 3, -0.4, ENEMY_BLUE, SHOT_SCALE_OLIVE, true );
    wait( 100 );
   // T_Subwave_B( GetStgFrameWidth/2 + 64, GetStgFrameHeight/3.5 );

    wait( 100 );
    T_Popcorn_Fairy_A2( GetStgFrameWidth() + 24, GetStgFrameHeight()/2.6, 180, 3, 0.4, ENEMY_BLUE, SHOT_SCALE_OLIVE, true );
    wait( 100 );
   // T_Subwave_B( GetStgFrameWidth/2 - 64, GetStgFrameHeight/3.5 );
    async{

        //wait( 120 );
        ascent (i in 0..4) {

            if( i % 2 == 0 ){
                T_Aimed_Fiary_A1( GetStgFrameWidth()/2 - 64 - i * 128/4, GetStgFrameHeight/2, 90, 3, -0.4, ENEMY_BLUE, SHOT_RICE_RED );
            }
            else{
                T_Aimed_Fiary_A1( GetStgFrameWidth()/2 - 64 - i * 128/4, GetStgFrameHeight/2, 90, 3, -0.4, ENEMY_RED, SHOT_RICE_BLUE );

            }
            //T_Aimed_Fiary_A1( GetStgFrameWidth()/2 - 64 - i * 128/4, GetStgFrameHeight/2, 90, 3, 0.3, ENEMY_BLUE, SHOT_BALL_RED );

            wait( 20 );
        }

        wait( 60 );

        ascent (i in 0..4) {

            if( i % 2 == 0 ){
                T_Aimed_Fiary_A1( GetStgFrameWidth()/2 + 64 - i * 128/4, GetStgFrameHeight/3, 90, 3, -0.4, ENEMY_BLUE, SHOT_RICE_RED );
            }
            else{
                T_Aimed_Fiary_A1( GetStgFrameWidth()/2 + 64 - i * 128/4, GetStgFrameHeight/3, 90, 3, -0.4, ENEMY_RED, SHOT_RICE_BLUE );

            }
            //T_Aimed_Fiary_A1( GetStgFrameWidth()/2 - 64 - i * 128/4, GetStgFrameHeight/2, 90, 3, 0.3, ENEMY_BLUE, SHOT_BALL_RED );

            wait( 20 );
        }                     

    }   

    wait( 460 );

    T_Wave_D();

    //T_Flower_Fiary_A1( GetStgFrameWidth()/2, GetStgFrameHeight()/4, -90, 1, 0.4, ENEMY_RED, SHOT_BALL_RED );
   // T_Wave_C();
    // do something
}

task T_Subwave_B( X, Y ){

    T_Aimed_Fiary_A1( X + 20, Y, 90 + rand( -20, 20 ), 3, -0.2, ENEMY_BLUE, SHOT_BALL_RED );
    T_Aimed_Fiary_A1( X - 20, Y, 90 + rand( -20, 20 ), 3, -0.2, ENEMY_RED, SHOT_BALL_RED );

    T_Aimed_Fiary_A1( X, Y -20, 90 + rand( -20, 20 ), 3, 0.2, ENEMY_BLUE, SHOT_BALL_RED );
    T_Aimed_Fiary_A1( X, Y + 20, 90 + rand( -20, 20 ), 3, 0.2, ENEMY_RED, SHOT_BALL_RED );


}

