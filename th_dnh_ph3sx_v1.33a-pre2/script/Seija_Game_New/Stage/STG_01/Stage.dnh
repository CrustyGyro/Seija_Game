task T_Wave_D(){

    ascent (i in 0..3) {
        T_Telegraph_Fairy_A( GetStgFrameWidth() - 24 + rand( -32, 8 ), GetStgFrameHeight/3, 90, 3, 0.1, ENEMY_BLUE, SHOT_BALL_RED );

        wait( 20 );

        T_Telegraph_Fairy_A( GetStgFrameWidth() - 24 + rand( -32, 8 ), GetStgFrameHeight/3, 90, 3, 0.1, ENEMY_RED, SHOT_BALL_RED );

        wait( 20 );        
    }

    ascent (i in 0..3) {
        T_Popcorn_Fairy_A1( GetStgFrameWidth() - 28, GetStgFrameHeight + 24, -90, 2, -0.2, ENEMY_BLUE, SHOT_BALL_RED, false );
      //  T_Telegraph_Fairy_A( GetStgFrameWidth() - 24 + rand( -32, 8 ), GetStgFrameHeight/3, 90, 3, 0.1, ENEMY_BLUE, SHOT_BALL_RED );

        wait( 20 );

       T_Popcorn_Fairy_A1( GetStgFrameWidth() - 28, GetStgFrameHeight + 24, -90, 2, -0.2, ENEMY_RED, SHOT_BALL_RED, true );

        wait( 20 );        
    }    

    ascent (i in 0..3) {
        T_Telegraph_Fairy_A( 24 + rand( 8, 32 ), GetStgFrameHeight/3, 90, 3, -0.1, ENEMY_BLUE, SHOT_BALL_RED );

        wait( 20 );

        T_Telegraph_Fairy_A( 24 + rand( 8, 32 ), GetStgFrameHeight/3, 90, 3, -0.1, ENEMY_RED, SHOT_BALL_RED );

        wait( 20 );        
    }

    T_Aimed_Fiary_A1( GetStgFrameWidth()/2 - 64, GetStgFrameHeight/3, 90, 3, 0.4, ENEMY_BLUE, SHOT_RICE_BLUE );
    T_Aimed_Fiary_A1( GetStgFrameWidth()/2 + 64, GetStgFrameHeight/3, 90, 3, -0.4, ENEMY_BLUE, SHOT_RICE_BLUE );

    T_Aimed_Fiary_A1( GetStgFrameWidth()/2 - 128, GetStgFrameHeight/3, 90, 3, 0.4, ENEMY_BLUE, SHOT_RICE_BLUE );
    T_Aimed_Fiary_A1( GetStgFrameWidth()/2 + 128, GetStgFrameHeight/3, 90, 3, -0.4, ENEMY_BLUE, SHOT_RICE_BLUE );    

    ascent (i in 0..3) {
        T_Popcorn_Fairy_A1( 28, GetStgFrameHeight + 24, -90, 2, 0.2, ENEMY_BLUE, SHOT_BALL_RED, false );
      //  T_Telegraph_Fairy_A( GetStgFrameWidth() - 24 + rand( -32, 8 ), GetStgFrameHeight/3, 90, 3, 0.1, ENEMY_BLUE, SHOT_BALL_RED );

        wait( 20 );

       T_Popcorn_Fairy_A1( 28, GetStgFrameHeight + 24, -90, 2, 0.2, ENEMY_RED, SHOT_BALL_RED, true );

        wait( 20 );        
    }  

    SetCommonData( "BG_Phase", 2 );


}