//----------------------------------------------------------------------------------------------------------
task T_Template_Enemy_A( X, Y, Angle, Speed, Wvel, Color, ShotColor ){
	
	int Shotcounter = 0;
			
	let Enemy = Create_Enemy_A1( X, Y, 32, FAIRY_S_NORMAL, Color, 1 );
	ObjMove_AddPatternA2( Enemy, 1, NO_CHANGE, Angle , 0.1, Speed, Wvel );
		
	float Enemy_X = ObjMove_GetX( Enemy );
	float Enemy_Y = ObjMove_GetY( Enemy );		
	float Frame = 0;
	int Shot_Delay = 60;
		
	async{
		while( !Obj_IsDeleted( Enemy ) ){
				
			Enemy_X = ObjMove_GetX( Enemy );
			Enemy_Y = ObjMove_GetY( Enemy );	
					
			Frame++;
			yield;			
				
		}			
	}			
	
	wait( Shot_Delay );
		
	while( !Obj_IsDeleted( Enemy ) && Shotcounter < 6 ){
			
		if( !Obj_IsDeleted( Enemy ) ){
								
			Shotcounter += 1;	
				
			let Shot_A = ShotR1( Enemy_X, Enemy_Y, 8, 1, GetAngleToPlayer( Enemy ), ShotColor, 10, ShotColor );
			T_PlaySE( SE_SHOT_03, 40 );
				
				
		}		

		wait( 60 );
		yield;
	}

}

//----------------------------------------------------------------------------------------------------------

task T_Popcorn_Fairy_A1( X, Y, Angle, Speed, Wvel, Color, ShotColor, Can_Shoot ){
	
	int Shotcounter = 0;
			
	let Enemy = Create_Enemy_A1( X, Y, 32, FAIRY_S_NORMAL, Color, 1 );
	ObjMove_AddPatternA2( Enemy, 1, NO_CHANGE, Angle , 0.1, Speed, Wvel );
	//T_Enemy_FadeIn_A1( Enemy, 120, 1 );
	//Obj_SetValue( Enemy, "Harmable", false );
		
	float Enemy_X = ObjMove_GetX( Enemy );
	float Enemy_Y = ObjMove_GetY( Enemy );		
	float Frame = 0;
	int Shot_Delay = 60;
		
	async{
		while( !Obj_IsDeleted( Enemy ) ){
				
			Enemy_X = ObjMove_GetX( Enemy );
			Enemy_Y = ObjMove_GetY( Enemy );	
					
			Frame++;
			yield;			
				
		}			
	}			
	
	wait( Shot_Delay );

	//Horribleness.

	float[] Rank_Speed = [ 1, 2, 3, 3.5, 8 ]; 
	int[] Rank_Count = [ 1, 1, 2, 3, 8 ]; 
	int Rank = GetCommonData( "Difficulty", MODE_NORMAL );
		
    if( Can_Shoot == true || GetCommonData( "Difficulty", MODE_NORMAL ) >= MODE_LUNATIC ){
		while( !Obj_IsDeleted( Enemy ) && Shotcounter < 3 ){
				
			if( !Obj_IsDeleted( Enemy ) ){
									
				Shotcounter += 1;	
				ascent (i in 0..Rank_Count[ Rank ]) {
	
					let Shot_A = ShotR1( Enemy_X, Enemy_Y, 8, Rank_Speed[ Rank ] + i * 0.5/Rank_Count[ Rank ], GetAngleToPlayer( Enemy ), ShotColor, 10, ShotColor );

				}	

				T_PlaySE( SE_SHOT_00, 40 );
					
					
			}		

			wait( 60 );
			yield;
		}
	}
}

//----------------------------------------------------------------------------------------------------------


task T_Popcorn_Fairy_A2( X, Y, Angle, Speed, Wvel, Color, ShotColor, Can_Shoot ){
	
	int Shotcounter = 0;
			
	let Enemy = Create_Enemy_A1( X, Y, 120, FAIRY_B_NORMAL, Color, 4 );
	ObjMove_AddPatternA2( Enemy, 1, NO_CHANGE, Angle , 0.08, Speed, Wvel );
	ObjMove_AddPatternA2( Enemy, 70, NO_CHANGE, NO_CHANGE, -0.05, Speed/3, Wvel );
	ObjMove_AddPatternA2( Enemy, 200, NO_CHANGE, NO_CHANGE , 0.01, Speed*1.2, Wvel );
		
	float Enemy_X = ObjMove_GetX( Enemy );
	float Enemy_Y = ObjMove_GetY( Enemy );		
	float Frame = 0;
	int Shot_Delay = 30;
		
	async{
		while( !Obj_IsDeleted( Enemy ) ){
				
			Enemy_X = ObjMove_GetX( Enemy );
			Enemy_Y = ObjMove_GetY( Enemy );	
					
			Frame++;
			yield;			
				
		}			
	}			
	
	wait( Shot_Delay );

	int[] Difficulty_Count = [ 3, 4, 8, 12, 25 ];
		
    if( Can_Shoot == true ){
		while( !Obj_IsDeleted( Enemy ) && Shotcounter < 5 ){
				
			int Shot_Count = Difficulty_Count[ GetCommonData( "Difficulty", MODE_NORMAL ) ];


			if( !Obj_IsDeleted( Enemy ) ){
									
				Shotcounter += 1;	
					
				ascent (i in 0..Shot_Count) {
					let Shot_A = ShotR1( Enemy_X, Enemy_Y, 8, 2 + i * 1.5/Shot_Count, ObjMove_GetAngle( Enemy ) + 90 , SHOT_BALL_DOLIVE, 10, SHOT_BALL_DOLIVE );
					let Shot_B = ShotR1( Enemy_X, Enemy_Y, 8, 2 + i * 1.5/Shot_Count, ObjMove_GetAngle( Enemy ) - 90 , SHOT_BALL_DOLIVE, 10, SHOT_BALL_DOLIVE );

					ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, -0.05, 0, 0 );
					ObjMove_AddPatternA2( Shot_B, 10, NO_CHANGE, NO_CHANGE, -0.05, 0, 0 );
					ObjMove_AddPatternA2( Shot_A, 120, 0, 90 + rand( -8, 8 ), 0.01, 1, 0 );
					ObjMove_AddPatternA2( Shot_B, 120, 0, 90 + rand( -8, 8 ), 0.01, 1, 0 );

					T_Manage_Shot( Shot_A );
					T_Manage_Shot( Shot_B );
				}	

				T_PlaySE( SE_SHOT_03, 40 );
					
					
			}		

			wait( 20 );
			yield;
		}
	}

	task T_Manage_Shot( Obj ){

		wait( 120 );

		if( !Obj_IsDeleted( Obj )){  
			int Effect_Shot = ShotR1( ObjMove_GetX( Obj ), ObjMove_GetY( Obj ), 0, 0, 90, SHOT_CLOUD_OLIVE, 8, SHOT_CLOUD_OLIVE ); 
			ObjShot_SetDeleteFrame( Effect_Shot, 4 );


			T_PlaySE( SE_CHIME_02, 40 );
			ObjShot_SetGraphic( Obj, ShotColor );
		
		}




	}
}

