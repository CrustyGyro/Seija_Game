        T_Repeating_Trees_A( Tex_Tree_00, 48, -96, i-5.5, 255, 0.5, 200, [ 255, 255, 255 ] );

        T_Repeating_Trees_A( Tex_Tree_01, 192, -160, i-5, 255, 0.5, 200, [ 255, 255, 255 ] );
        T_Repeating_Trees_A( Tex_Tree_00, 192*1.5, -160, i-5.5, 255, 0.5, 200, [ 255, 255, 255 ] );       

       // T_Repeating_Trees_A( Tex_Tree_01, -96*2, -96, i-5, 255, 0.5, 128, [ 255, 255, 255 ] );
        //T_Repeating_Trees_A( Tex_Tree_01, 96*2, -96, i-5.5, 255, 0.5, 128, [ 255, 255, 255 ] );

