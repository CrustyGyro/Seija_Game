//----------------------------------------------------------------------

task T_Cam_Phase_1{
	
	Cam_X = 0;
	Cam_Y = 0;
	Cam_Z = 0;	
	
	SetCameraPerspectiveClip( -1, 1000 );
	SetCameraPosEye( Cam_X, Cam_Y, Cam_Z );
	SetCameraAzimuthAngle( -90 );
	SetCameraElevationAngle( 45 );
	SetCameraRadius( 400 );
		
	yield;
	
}

//----------------------------------------------------------------------

task T_Cam_Phase_2{
	
	Cam_X = 0;
	Cam_Y = 0;
	Cam_Z = 0;	
	
	float Reveal_Time = 500;	
	
	SetCameraPerspectiveClip( -1, 1000 );
	SetCameraPosEye( Cam_X, Cam_Y, Cam_Z );
	SetCameraAzimuthAngle( -90 );
	SetCameraElevationAngle( 45 );
	SetCameraRadius( 400 );
	
	
	ascent( time in 0..Reveal_Time ){
		
		Cam_Y = Interpolate_Smoother( 0, 64, time/Reveal_Time );
		float Elevation = Interpolate_Smoother( 45, 20, time/Reveal_Time );		
		
		
		SetCameraElevationAngle( Elevation );
		SetCameraPosEye( Cam_X, Cam_Y, Cam_Z );
		
		yield;
		
	}		

	yield;
	
}

