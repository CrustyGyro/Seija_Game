#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Nina_Spell_05"]
#Background["./Stage/STG_05/FW_Stage_5.dnh"];
#Player[ "./Player/PL_Reimu.dnh" ]
#System["./System/System_Main_Hud.dnh"]

//--------------------------------------------------Variables------------------------------------------------------

let bossObj;
let objScene = GetEnemyBossSceneObjectID();
let bossX = 0;
let bossY = 0;

//SetIntersectionVisualization( true );
let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/FW_Boss_EX.png";

//---------------------------------------------------Include-------------------------------------------------------

	#include "./lib/Index_Boss.dnh"
	#include "./lib/Lib_Spell.dnh"
	#include "./lib/Lib_SpellCutin.dnh"

//----------------------------------------------------Start--------------------------------------------------------

@Loading {
	
    LoadTexture( CutinTex );

}


@Initialize {

	bossObj = ObjEnemy_Create(OBJ_ENEMY_BOSS);	
	
	ObjEnemy_Regist( bossObj );	

	T_Lifebar( bossObj );
	T_HitEffect( bossObj );
	ObjEnemy_SetDamageRate( bossObj, 0, 0 );	

	Init_Boss_Nina( bossObj );
	
	ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2, GetStgFrameHeight/3, 15, 8 );
	
	//SetPlayerLife( 8 );
	T_Main;
	T_End;
	
}

@Event { 

	alternative(GetEventType()) 
	case( EV_REQUEST_LIFE ) { 
		SetScriptResult( 1000 ); // 3000-4500 For Nons ( At 100% Damage Rate. )
	}
	case( EV_REQUEST_TIMER ) { 
		//SetScriptResult( 50 );
		SetScriptResult( 50 );
	}	
	case( EV_REQUEST_SPELL_SCORE ){
       SetScriptResult( 9500000 );
    }	

} 

@MainLoop {

	bossX = ObjMove_GetX( bossObj );
	bossY = ObjMove_GetY( bossObj );
	
	SetCommonData( "Effect_X", bossX );
	SetCommonData( "Effect_Y", bossY );	

	ObjEnemy_SetIntersectionCircleToShot( bossObj, bossX, bossY, 16 );
	ObjEnemy_SetIntersectionCircleToPlayer( bossObj, bossX, bossY, 8 );
	
	yield;
}

@Finalize {
} 


task T_InitSpell(){
	
	//let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/CurseOfRa.png";
	
	T_CallSpell_A1( "\"Truth: Predictive Programming\"", 0, "Normal", objScene );
	T_Call_Spell_Cutin( CutinTex, [ 0, 0, 450, 480 ], 0.8, CC_PINK );	
	
	ObjEnemyBossScene_StartSpell( objScene );
	
	yield;
	T_SpellBG_Nina();
	
}	


//----------------------------------------------------Patterns--------------------------------------------------------

task T_Main {


	//NotifyEventAll( EV_BOSS_EFFECT, bossObj, CC_PINK );
	//T_Shoot_Banner( "Watari Nina", CC_PINK, 40 );

	wait( 60 );

	T_PlaySE( SE_CHARGE_00, 30 );
	T_Charge_A1( bossObj, 20, "Petal", CC_PINK );

	wait( 40 );    

	T_InitSpell();
	
	wait( 200 );    

	//ObjEnemy_SetDamageRate( bossObj, 0.3, 0.3 );
	
	T_Boss_Shot_A;
    //T_Movement_A;
	
	//T_Boss_Shot_B();
	
	wait( 240 );

    ObjEnemy_SetDamageRate( bossObj, 0.3, 0.3 );

	/*
	while ( !Obj_IsDeleted( bossObj )) {
		// do something
		ascent (a in 0..4) {
			ascent (i in 0..180) {

				let Laser_A = Laser_A1( ObjMove_GetX( bossObj ), ObjMove_GetY( bossObj ), 90 + i * 360/180 + a * 45/4, 512, 14, 12, SHOT_LASER_DYELLOW, 8 );
				wait( 4 );
			}

			//wait( 4 );
		}	
		wait( 4 );
	}
	*/
	//T_Boss_Shot_D();
	//T_Movement_A( );

}	

task T_Movement_A{

	float X = 0;
	float Y = 0;
	
	while( Boss_Is_Alive( bossObj ) ){

		ObjMove_SetDestAtWeight( bossObj, bossX + 32 * cos( X ), bossY + 32 * sin( Y ), 64, 3 );
		X += 1;
		Y += 1;
		
		yield;
	}

}

task T_Boss_Shot_A(){

	float Base_Angle = 0;

	async{

		wait( 300 );

		int Shot_Count = 24;
		float Angle = 0;
		float Dir = 0.08;

		while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {

			ascent ( a in 0..Shot_Count ) {
				ascent ( c in 0..2 ) {
					int Shot_Name_A = ShotR1( bossX, bossY, 32, 1, Angle + a * ( 360 )/Shot_Count + c * 2/2, SHOT_BULLET_RED, 8, DELAY_CLOUD_RED );
					int Shot_Name_B = ShotR1( bossX, bossY, 32, 1, Angle - a * ( 360 )/Shot_Count - c * 2/2, SHOT_BULLET_BLUE, 8, DELAY_CLOUD_BLUE );

					ObjMove_AddPatternA2( Shot_Name_A, 24, 0, NO_CHANGE, 0.01, 8, Dir );
					ObjMove_AddPatternA2( Shot_Name_B, 24, 0, NO_CHANGE, 0.01, 8, Dir );
				}
				//wait( 1 );

				Dir = -Dir;
			}

			Angle += 10;
			wait( 26 );
		}	

	}

    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {

        //-------------------------------------------------------------------------------

		//float Base_Angle = rand( -60, 60 );

		async {
			wait( 200 );
			T_PlaySE( SE_CHARGE_03, 30 );
			//T_Charge_A1( bossObj, 10, "Petal", CC_RED );
			//T_Concentrate_Circle_A( bossX, bossY, 128, CC_RED );
			if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
				T_Charge_Circle_A2( bossObj, 20, 20, 3, 0, CC_RED, LERP_SMOOTHER );
			}
			//T_Charge_B1( bossObj, prand( 0, 360 ), 2, 32, 15, 10, CC_RED );

			wait( 40 );

			if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
				T_Charge_Circle_A2( bossObj, 60, 10, 0, 8, CC_RED, LERP_SMOOTHER );
				T_Charge_Burst_A( bossObj, "Petal", CC_RED );
				T_PlaySE( SE_LASER_04, 30 );
			}
		}

		ascent ( a in 0..20 ) {

			if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
				
				Base_Angle = rand( -45, 45 );

				T_PlaySE( SE_LASER_03, 30 );

				T_Create_Prediction_Laser( -16, 0 + a * GetStgFrameHeight()/19, 0 + Base_Angle, 240 );
				T_Create_Prediction_Laser( GetStgFrameWidth() + 16, 0 + a * GetStgFrameHeight()/19, 180 + Base_Angle, 240 );

			}

			wait( 2 );

		}	

		wait( 320 );

    }

	task T_Create_Prediction_Laser( X, Y, Angle, Time ){

		int Laser_Telgraph =  CreateStraightLaserA1( X, Y, Angle, 600, 16, 60, SHOT_LASER_RED, 60 );
		ObjStLaser_SetPermitExpand( Laser_Telgraph, false );
		T_FadeOut_Delete( Laser_Telgraph, 60, 255 );
		T_LaserReady( Laser_Telgraph, 512, 30 );

		async{

			while( !Obj_IsDeleted( Laser_Telgraph ) ){

				int Laser_Telgraph_Pulse =  CreateStraightLaserA1( X, Y, Angle, 512, 16, 60, SHOT_CURVY_LASER_RED, 0 );
				T_FadeOut_Delete( Laser_Telgraph_Pulse, 30, 55 );
				T_Manage_LaserPulse( Laser_Telgraph_Pulse );

				ObjLaser_SetLength( Laser_Telgraph_Pulse, ObjLaser_GetLength( Laser_Telgraph ) );
				ObjStLaser_SetSource( Laser_Telgraph_Pulse, false );
				ObjShot_SetIntersectionEnable( Laser_Telgraph_Pulse, false );
				wait( 20 );
			}

		}

		wait( Time );
		
		if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {

			T_PlaySE( SE_LASER_05, 30 );
			int Real_Laser_A = Laser_A1( X, Y, Angle, 600, 10, 80, SHOT_LASER_RED, 1 );

		}
		//int Real_Laser_L = CreateLooseLaserA1( X, Y, rand( 6, 15 ), Angle, 512, 12, SHOT_CURVY_LASER_RED, 1 );

		task T_Manage_LaserPulse( Obj ){

			ObjRender_SetColor( Obj, 255, 0, 0 );

			float Width = 0;

			while( !Obj_IsDeleted( Obj ) ){

				ObjLaser_SetRenderWidth( Obj, 0 + Width );

				Width+= 64/30;

				yield;

			}	

		}

	}

}

task T_Boss_Shot_B(){

	while( Boss_Is_Alive( bossObj ) ){

		ascent ( i in 0..25 ) {
			int ShotObj_A = ShotR1( bossX, bossY, 32, 1, 90 + i * 360/25, SHOT_SEIJA_FIREBALL_RED, 0, SHOT_SEIJA_FIREBALL_RED );
			//T_BulletTrail( ShotObj_A, CC_ORANGE, 2, SHOT_BALL_RED, 1.5 );
			ObjMove_AddPatternA2( ShotObj_A, 1, 0, NO_CHANGE, 0.01, 6, 0 );

			//yield;
		}
		wait( 80 );
	}

	task T_BulletTrail( Obj, Color, Rate, Graphic, Size ){

		while( !Obj_IsDeleted( Obj )){

			//int Shot_Name_A = ShotR1( ObjMove_GetX(Obj), ObjMove_GetY(Obj), 0, 1,  ObjMove_GetAngle(Obj) + 180 + rand( -32, 32 ), SHOT_BALL_PURPLE, 0, SHOT_BALL_PURPLE );
			//ObjRender_SetBlendType( Shot_Name_A, BLEND_ADD_ARGB );
			//ObjRender_SetColor( Shot_Name_A, 255, 255, 255 );
			//ObjShot_SetDeleteFrame( Shot_Name_A, 1 );

			int Shot_Name_B = ShotR1( ObjMove_GetX(Obj), ObjMove_GetY(Obj), 0, 1,  ObjMove_GetAngle(Obj) + 180 + rand( -32, 32 ), Graphic, 0, Graphic );
			ObjRender_SetBlendType( Shot_Name_B, BLEND_ADD_ARGB );
			ObjRender_SetColor( Shot_Name_B, Color[0], Color[1], Color[2] );
			T_ManageTrail_Obj( Shot_Name_B );
			ObjShot_SetDeleteFrame( Shot_Name_B, 1 );	
			ObjShot_SetIntersectionEnable( Shot_Name_B, false );

			wait( Rate );
		}

		task T_ManageTrail_Obj( Trail_Shot ){

			ascent (i in 0..20) {
				
				ObjRender_SetScaleXYZ( Trail_Shot, Size - i * Size/20, Size - i * Size/20, Size - i * Size/20 );

				yield;
			}

		}


	}	


}

//-----------------------------------------------------Death---------------------------------------------------------

task T_End {
	
    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
	     yield;
	}
	
	if( ObjEnemyBossScene_GetInfo( GetEnemyBossSceneObjectID, INFO_IS_LAST_STEP ) ){

		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		
		yield;
		
		SetAutoDeleteObject(true);
		T_Boss_Shotdown( bossObj, "Petal", CC_CYAN );
		wait( 200 );
		
		Obj_Delete( bossObj );	
		
		//lol
		ENEMY_CLEAR = true;
		
		yield;
		
		ENEMY_CLEAR = false;
		
		wait( 800 );
		
		CloseScript( GetOwnScriptID() );
		
	}	
	else{
	
		NotifyEventAll( EV_SPAWN_ITEM_NON, bossX, bossY, 38, 64 );	
		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		//DeleteShotAll( TYPE_ALL, TYPE_ITEM );
		
		yield;
		
		SetAutoDeleteObject( true );
		
		Obj_Delete( bossObj );	
		
		wait( 60 );
		
		//DeleteShotAll(TYPE_ALL, TYPE_ITEM);
		
		CloseScript( GetOwnScriptID() );
	
	}
	
	//SetAutoDeleteObject(true);
	
	//Obj_Delete( bossObj );	
	//CloseScript( GetOwnScriptID() );
	
}

