#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Nina_Spell_03"]
#Background["./Stage/STG_05/FW_Stage_5.dnh"];
#Player[ "./Player/PL_Reimu.dnh", "./Player/PL_Remilia.dnh"]
#System["./System/System_Main_Hud.dnh"]

//--------------------------------------------------Variables------------------------------------------------------

let bossObj;
let objScene = GetEnemyBossSceneObjectID();
let bossX = 0;
let bossY = 0;

int Dir_Switch = 1;

//SetIntersectionVisualization( true );
let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/FW_Boss_EX.png";


//---------------------------------------------------Include-------------------------------------------------------

	#include "./lib/Index_Boss.dnh"
	#include "./lib/Lib_Spell.dnh"
	#include "./lib/Lib_SpellCutin.dnh"

//----------------------------------------------------Start--------------------------------------------------------

@Loading {
	
    LoadTexture( CutinTex );

}


@Initialize {

	bossObj = ObjEnemy_Create(OBJ_ENEMY_BOSS);	
	
	ObjEnemy_Regist( bossObj );	

	T_Lifebar( bossObj );
	T_HitEffect( bossObj );
	ObjEnemy_SetDamageRate( bossObj, 0, 0 );	

	Init_Boss_Nina( bossObj );
	
	ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2, GetStgFrameHeight/3, 15, 8 );
	
	//SetPlayerLife( 8 );
	T_Main;
	T_End;
	
}

@Event { 

	alternative(GetEventType()) 
	case( EV_REQUEST_LIFE ) { 
		SetScriptResult( 1000 ); // 3000-4500 For Nons ( At 100% Damage Rate. )
	}
	case( EV_REQUEST_TIMER ) { 
		//SetScriptResult( 50 );
		SetScriptResult( 60 );
	}	
	case( EV_REQUEST_SPELL_SCORE ){
       SetScriptResult( 8800000 );
    }	

} 

@MainLoop {

	bossX = ObjMove_GetX( bossObj );
	bossY = ObjMove_GetY( bossObj );
	
	SetCommonData( "Effect_X", bossX );
	SetCommonData( "Effect_Y", bossY );	

	ObjEnemy_SetIntersectionCircleToShot( bossObj, bossX, bossY, 16 );
	ObjEnemy_SetIntersectionCircleToPlayer( bossObj, bossX, bossY, 8 );
	
	yield;
}

@Finalize {
} 


task T_InitSpell(){
	
	//let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/CurseOfRa.png";
	
	T_CallSpell_A1( "\"Truth: Dyson Rotator\"", 0, "Normal", objScene );
	T_Call_Spell_Cutin( CutinTex, [ 0, 0, 450, 480 ], 0.8, CC_PINK );	
	
	ObjEnemyBossScene_StartSpell( objScene );
	
	yield;
	T_SpellBG_Nina();
	
}	


//----------------------------------------------------Patterns--------------------------------------------------------

task T_Main {


	//NotifyEventAll( EV_BOSS_EFFECT, bossObj, CC_PINK );
	//T_Shoot_Banner( "Watari Nina", CC_PINK, 40 );

	wait( 125 );

	T_PlaySE( SE_CHARGE_00, 30 );
	T_Charge_A1( bossObj, 20, "Petal", CC_PINK );

	wait( 80 );    

	T_InitSpell();
	
	wait( 160 );    

	ObjEnemy_SetDamageRate( bossObj, 0.2, 0.2 );
	
	T_Boss_Shot_A;
	
	//T_Boss_Shot_B();
	
	wait( 100 );

    async{

        wait( 400 );

        T_PlaySE( SE_CHARGE_00, 30 );
        T_Charge_A1( bossObj, 20, "Petal", CC_GREEN );

        wait( 80 );         

        while ( !Obj_IsDeleted( bossObj )) {

            T_PlaySE( SE_SHOT_01, 30 );

            ascent (i in 0..4) {
                int Aimed_Shots_A = ShotA2( bossX, bossY, 0.6, GetAngleToPlayer( bossObj ) + i * 10/4, SHOT_GEM_GREEN, 10, SHOT_GEM_GREEN );
                Obj_SetRenderPriorityI( Aimed_Shots_A, Obj_GetRenderPriorityI( Aimed_Shots_A ) + 1 );

                int Aimed_Shots_B = ShotA2( bossX, bossY, 0.6, GetAngleToPlayer( bossObj ) - i * 10/4, SHOT_GEM_GREEN, 10, SHOT_GEM_GREEN );
                Obj_SetRenderPriorityI( Aimed_Shots_B, Obj_GetRenderPriorityI( Aimed_Shots_B ) + 1 );                
            }

            wait( 200 );
        }
    }
	
	while ( !Obj_IsDeleted( bossObj )) {
		// do something

        ObjMove_SetDestAtFrame( bossObj, GetStgFrameWidth()/2 + rand( -64, 64 ), GetStgFrameHeight/3 + rand( -64, 16 ), 300, LERP_SMOOTHER );
		wait( 300 );
        /*
        ascent (i in 0..12) {
            ShotA2( bossX, bossY, 1, GetAngleToPlayer( bossObj ) + i * 360/12, SHOT_SEIJA_FIREBALL_ALT_GREEN, 20, SHOT_SEIJA_FIREBALL_ALT_GREEN );
        }
        */
		wait( 100 );
	}
    //T_Boss_Shot_D();
	//T_Movement_A( bossObj );
	
}	

task T_Boss_Shot_A{

    float Angle_RNG = rand( 0, 360 );
    float Dir = 1.5;


    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){ 

        T_PlaySE( SE_SPECIAL_00, 30 );

        ascent (a in 0..4) {

            if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) <= 0 ){ break; } 

            Angle_RNG = rand( 0, 360 );
            T_Create_Dyson( 0 + a * GetStgFrameWidth()/3, 0, 1, 90, 12, SHOT_ORB_ORANGE, SHOT_BALL_DORANGE, 90, Dir );

            Dir = -Dir;
            //wait( 60 );
            yield;
        } 

        Dir = -Dir;
        wait( 144 );

        T_PlaySE( SE_SPECIAL_00, 30 );

        ascent (a in 0..5) {

            if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) <= 0 ){ break; } 

            Angle_RNG = rand( 0, 360 );
            T_Create_Dyson( 0 + a * GetStgFrameWidth()/4, 0, 1, 90, 14, SHOT_ORB_ORANGE, SHOT_BALL_DORANGE, 90, Dir );

            Dir = -Dir;
            //wait( 60 );
            yield;
        } 

        Dir = -Dir;
        wait( 144 );

    }   

    task T_Create_Dyson( X, Y, Speed, Angle, Count, Color_A, Color_B, Initial_Angle, Dir ){

        int Way = Count;
        int Stack = 1;

        int Shot_Color = SHOT_BALL_DORANGE;

        int Sun_Core = ShotA2( X, Y, Speed,Angle, Color_A, 20, Color_A );
        int Sun_Core_Dummy = ShotA2( X, Y, Speed,Angle, SHOT_LARGE_STAR_YELLOW, 0, SHOT_LARGE_STAR_YELLOW );
        ObjRender_SetScaleXYZ( Sun_Core_Dummy, 1.8, 1.8, 1.8 );
        ObjRender_SetBlendType( Sun_Core_Dummy, BLEND_ADD_ARGB );
        ObjRender_SetColor( Sun_Core_Dummy, 155, 55, 55 );

        T_Burst_Circle_A2( Sun_Core, 40, 2.8, CC_YELLOW );

        int Sun_Core_Dummy_Glow = ShotA2( X, Y, Speed,Angle, SHOT_ORB_RED, 0, SHOT_ORB_RED );
        ObjRender_SetScaleXYZ( Sun_Core_Dummy_Glow, 1.8, 1.8, 1.8 );
        ObjRender_SetBlendType( Sun_Core_Dummy_Glow, BLEND_ADD_ARGB );
        ObjRender_SetColor( Sun_Core_Dummy_Glow, 255, 100, 100 );  
        ObjRender_SetAlpha( Sun_Core_Dummy_Glow, 55 );      

        int[] Dummy_Shots = Pattern_Shot_A1( X, Y, 0, 32, 360, 0, Color_B, PATTERN_RING, Way, Stack, 0, Color_B );
        //int[] Dummy_Shots_B = Pattern_Shot_A1( X, Y, 0, 32, 360, 0, Color_B, PATTERN_RING, Way, Stack, 0, Color_B );

        for( int a = 0; a < Way * Stack; a++ ) {

            if( a % 2 == 0 ){ 
                Shot_Color = SHOT_DDP_STAR_RED;
                ObjShot_SetIntersectionEnable( Dummy_Shots[ a ], false );
                ObjRender_SetColor( Dummy_Shots[ a ], 255, 55, 55 );
                ObjRender_SetAlpha( Dummy_Shots[ a ], 100 );
                ObjRender_SetBlendType( Dummy_Shots[ a ], BLEND_ADD_ARGB );
            }
            else{ 
                Shot_Color = SHOT_DDP_STAR_ORANGE; 
                //ObjRender_SetBlendType( Dummy_Shots[ a ], BLEND_ADD_ARGB );
                
            }
            T_Rotate_Dyson( Sun_Core, Dummy_Shots[ a ], 64, Initial_Angle, 100, Dir, Shot_Color );
            //T_Rotate_Dyson( Sun_Core, Dummy_Shots_B[ a ], 32, Initial_Angle, 100, -Dir, Shot_Color );
        }

        task T_Rotate_Dyson( Parent, Shot, Radius, Initial_Angle, Time, Dir, Color_A ){

            ObjShot_SetAutoDelete( Shot, false );
            ObjShot_SetGraphic( Shot, Color_A );
                
            async{
                    
                float Angle = dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Parent ), ObjMove_GetY( Parent ) );
                float Frame = 0;
                float Inital_Radius = 0;
                float Angle_Init = Initial_Angle;
                    
                ascent( i in 0..Time ){
                    
                    if( Obj_IsDeleted( Parent ) ){  Obj_Delete( Shot ); }
                    float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle/2 );
                    float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle/2 );					
                                    
                        //Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
                    Inital_Radius = Interpolate_Overshoot( 0, Radius, 1.5, i/Time );

                    Angle+= Dir;	

                    ObjMove_SetPosition( Sun_Core_Dummy, ObjMove_GetX( Parent ), ObjMove_GetY( Parent ) );
                    ObjMove_SetPosition( Sun_Core_Dummy_Glow, ObjMove_GetX( Parent ), ObjMove_GetY( Parent ) );           
                    ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
                    ObjMove_SetAngle( Shot, Angle );
                        
                    yield;
                        
                }	

                    
                while( !Obj_IsDeleted( Parent ) ){
                        
                    float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle/2 );
                    float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle/2 );					
                        
                    Angle+= Dir;		
                        //Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
                    //Inital_Radius = Interpolate_Overshoot( 0, Radius, 2, i/Time );				
                                        
                    ObjMove_SetPosition( Sun_Core_Dummy, ObjMove_GetX( Parent ), ObjMove_GetY( Parent ) ); 
                    ObjMove_SetPosition( Sun_Core_Dummy_Glow, ObjMove_GetX( Parent ), ObjMove_GetY( Parent ) );                   
                    ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
                    ObjMove_SetAngle( Shot, Angle );
                        
                    yield;
                        
                }	
                
                Obj_Delete( Shot );
                Obj_Delete( Sun_Core_Dummy );
                Obj_Delete( Sun_Core_Dummy_Glow );
            
            }
                
        }

    }
	
}	


//-----------------------------------------------------Death---------------------------------------------------------

task T_End {
	
    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
	     yield;
	}
	
	if( ObjEnemyBossScene_GetInfo( GetEnemyBossSceneObjectID, INFO_IS_LAST_STEP ) ){

		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		
		yield;
		
		SetAutoDeleteObject(true);
		T_Boss_Shotdown( bossObj, "Petal", CC_CYAN );
		wait( 200 );
		
		Obj_Delete( bossObj );	
		
		//lol
		ENEMY_CLEAR = true;
		
		yield;
		
		ENEMY_CLEAR = false;
		
		wait( 800 );
		
		CloseScript( GetOwnScriptID() );
		
	}	
	else{
	
		NotifyEventAll( EV_SPAWN_ITEM_NON, bossX, bossY, 38, 64 );	
		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		//DeleteShotAll( TYPE_ALL, TYPE_ITEM );
		
		yield;
		
		SetAutoDeleteObject( true );
		
		Obj_Delete( bossObj );	
		
		wait( 60 );
		
		//DeleteShotAll(TYPE_ALL, TYPE_ITEM);
		
		CloseScript( GetOwnScriptID() );
	
	}
	
	//SetAutoDeleteObject(true);
	
	//Obj_Delete( bossObj );	
	//CloseScript( GetOwnScriptID() );
	
}

