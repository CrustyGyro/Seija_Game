#TouhouDanmakufu[Stage]
#ScriptVersion[3]
#Title["Nareko_Stage_Test"]
#Player[ "./Player/PL_Reimu.dnh" ]
#Background["./Stage/STG_03/FW_Stage_3_BG.dnh"];
#System["./System/System_Main_Hud.dnh"]

//--------------------------------------------------Variables------------------------------------------------------

let Stage_BGM = ID_INVALID;
let Boss_BGM = ID_INVALID;

//---------------------------------------------------Include-------------------------------------------------------

	#include "./Enemy_Def_A.dnh"
	#include "./System/Common.dnh"
	#include "./System/Constants.dnh"
	#include "./lib/Lib_Shot.dnh"
	#include "./lib/Lib_Enemy.dnh"
	#include "./lib/Shot/shot_const.dnh"

//----------------------------------------------------Start--------------------------------------------------------

@Initialize {
	
	SetCommonData( "BG_Phase", 1 );

	SetPlayerLife( 8 );
	T_StageBGM;
	T_Main;
	//T_End;
	
}


@MainLoop {

	yield;
	
}

@Finalize {
} 

//----------------------------------------------------Patterns--------------------------------------------------------

task T_Main {

	//T_Wave1Ghost_Enemy_A( -24, Get_CenterY, 0, 1, -0.1, 0.5, ENEMY_GREEN, SHOT_ICE_DBLUE );
	//wait( 700 );
	T_Wave_A;
	
	//T_Wave_C();
	
	//wait( 1000 );
	//T_Wave_B;
	//wait( 5000 );
	//CloseScript( GetOwnScriptID() );

}	

task T_StageBGM {
	
	Stage_BGM = ObjSound_Create();
	ObjSound_Load( Stage_BGM, GetCurrentScriptDirectory() ~ "./Resource/Bgm/BGM_Stage_03.ogg" );
	
	ObjSound_SetResumeEnable( Stage_BGM, true );
	ObjSound_SetSoundDivision( Stage_BGM, SOUND_BGM );
	ObjSound_SetLoopEnable( Stage_BGM, true );
	ObjSound_SetLoopSampleCount( Stage_BGM, 003481845, 010000047 );
	ObjSound_SetVolumeRate( Stage_BGM, 15 );
	ObjSound_Play( Stage_BGM );
	
}

task T_Wave_A{
	
		float Wvel = 0.03;
		float Dir_A = 1;
		int Fairy_Count = 12;
		
		//LINE_MOD_STAGE = 0.1;
	
		loop(1){
			ascent( i in 0..Fairy_Count ){

				T_Wave1Fairy_A( 32 + i * Get_MaxX/Fairy_Count, -24, 90, 2, Wvel, ENEMY_GREEN, SHOT_ICE_DBLUE );

				Wvel = -Wvel;
				wait( 20 );

			}
			descent( i in 0..Fairy_Count ){

				T_Wave1Fairy_A( 32 + i * Get_MaxX/Fairy_Count, -24, 90, 2, Wvel, ENEMY_GREEN, SHOT_ICE_DBLUE );

				Wvel = -Wvel;
				wait( 20 );

			}			
			
			wait( 250 );
			//wait( 500 );
			ascent( i in 0..2 ){
				
				ascent( i in 0..4 ){

					T_Wave1Ghost_Enemy_A( -24, Get_CenterY/2 + rand( -24, 32 ), 0, 1.5, -0.08, Dir_A, ENEMY_GREEN, SHOT_BALL_AURA_YELLOW );

					Dir_A = -Dir_A;
					
					wait( 60 );		
						
					
				}
				ascent( i in 0..4 ){

					T_Wave1Ghost_Enemy_A( Get_MaxX + 24, Get_CenterY/2 + rand( -24, 32 ), 180, 1.5, 0.08, Dir_A, ENEMY_GREEN, SHOT_BALL_AURA_YELLOW );

					Dir_A = -Dir_A;
					
					wait( 60 );		
						
					
				}		
				wait( 60 );
			}
			
			yield;
						
			
		}
		
	//	wait( 280 );
		
		T_Wave_B;
	
}	

task T_Wave_B{
	
	/*
	async{
		
		wait( 100 );
		
		T_Wave_C();
		
		
		
		
	}	
	*/
	ascent( a in 0..10 ){
		ascent( i in 0..4 ){
			T_BigFiary_A( 24 + i * Get_MaxX/4, -24, 90, 2, -0.2, ENEMY_YELLOW, SHOT_BALL_AURA_DYELLOW );
		
			
			T_BigFiary_A( Get_MaxX - 24 - i * Get_MaxX/4, -24, 90, 3, -0.2, ENEMY_YELLOW, SHOT_BALL_AURA_DYELLOW );
			
			wait( 10 );
		
		}
		
		wait( 160 );
		
		/*
		ascent( c in 0..4 ){
			T_BigFiary_A( 24 + c * Get_MaxX/4, -24, 90, 3 + a, -0.2, ENEMY_YELLOW, SHOT_BALL_AURA_DYELLOW );
		
			
			T_BigFiary_A( Get_MaxX - 24 - c * Get_MaxX/4, -24, 90, 2 + a, -0.2, ENEMY_YELLOW, SHOT_BALL_AURA_DYELLOW );
		
		}		
		
		wait( 140 );
		*/
	
	}
	
	wait( 280 );
	SetCommonData( "BG_Phase", 2 );	
}	

task T_Wave_C{
	
	ascent( i in 0..6 ){
		T_Wave2Fairy_A( -24, Get_CenterY/1.5 + rand( -64, 64 ), 0, 1.5, 0, ENEMY_YELLOW, SHOT_RICE_DMINT );
	
		wait( 120 );
	
	}
	
}

