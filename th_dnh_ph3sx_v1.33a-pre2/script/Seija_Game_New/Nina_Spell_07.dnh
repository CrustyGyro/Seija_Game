#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Nina_Spell_07"]
#Background["./Stage/STG_05/FW_Stage_5.dnh"];
#Player[ "./Player/PL_Reimu.dnh" ]
#System["./System/System_Main_Hud.dnh"]

//--------------------------------------------------Variables------------------------------------------------------

let bossObj;
let objScene = GetEnemyBossSceneObjectID();
let bossX = 0;
let bossY = 0;

//SetIntersectionVisualization( true );
let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/FW_Boss_EX.png";

//---------------------------------------------------Include-------------------------------------------------------

	#include "./lib/Index_Boss.dnh"
	#include "./lib/Lib_Spell.dnh"
	#include "./lib/Lib_SpellCutin.dnh"

//----------------------------------------------------Start--------------------------------------------------------

@Loading {
	
    LoadTexture( CutinTex );

}


@Initialize {

	bossObj = ObjEnemy_Create(OBJ_ENEMY_BOSS);	
	
	ObjEnemy_Regist( bossObj );	

	T_Lifebar( bossObj );
	T_HitEffect( bossObj );
	ObjEnemy_SetDamageRate( bossObj, 0, 0 );	

	Init_Boss_Nina( bossObj );
	
	ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2, GetStgFrameHeight/3, 15, 8 );
	
	//SetPlayerLife( 8 );
	T_Main;
	T_End;
	
}

@Event { 

	alternative(GetEventType()) 
	case( EV_REQUEST_LIFE ) { 
		SetScriptResult( 1000 ); // 3000-4500 For Nons ( At 100% Damage Rate. )
	}
	case( EV_REQUEST_TIMER ) { 
		//SetScriptResult( 50 );
		SetScriptResult( 50 );
	}	
	case( EV_REQUEST_SPELL_SCORE ){
       SetScriptResult( 9500000 );
    }	

} 

@MainLoop {

	bossX = ObjMove_GetX( bossObj );
	bossY = ObjMove_GetY( bossObj );
	
	SetCommonData( "Effect_X", bossX );
	SetCommonData( "Effect_Y", bossY );	

	ObjEnemy_SetIntersectionCircleToShot( bossObj, bossX, bossY, 16 );
	ObjEnemy_SetIntersectionCircleToPlayer( bossObj, bossX, bossY, 8 );
	
	yield;
}

@Finalize {
} 


task T_InitSpell(){
	
	//let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/CurseOfRa.png";
	
	T_CallSpell_A1( "\"Truth: Pillars Of Agartha \"", 0, "Normal", objScene );
	T_Call_Spell_Cutin( CutinTex, [ 0, 0, 450, 480 ], 0.8, CC_PINK );	
	
	ObjEnemyBossScene_StartSpell( objScene );
	
	yield;
	T_SpellBG_Nina();
	
}	


//----------------------------------------------------Patterns--------------------------------------------------------


task T_Main {


	//NotifyEventAll( EV_BOSS_EFFECT, bossObj, CC_CYAN );

	yield;

	wait( 45 );	

	T_PlaySE( SE_CHARGE_00, 30 );
	T_Charge_A1( bossObj, 20, "Petal", CC_PINK );

	wait( 30 );	    

    T_InitSpell();
	//T_Create_Pillar( GetStgFrameWidth(), GetStgFrameHeight(), 0, -96, 96, 0 );
	
	//T_PlaySE( SE_CHARGE_00, 30 );
	//T_Charge_A1( bossObj, 20, "Petal", CC_PINK );

	//wait( 100 );	

	
	
	ObjEnemy_SetDamageRate( bossObj, 0.12, 0.12 );

	while( Boss_Is_Alive( bossObj ) ){
		
		T_Create_Pillar( GetStgFrameWidth(), GetStgFrameHeight(), 0, GetStgFrameWidth()/2 + 32, GetStgFrameWidth()/2 + 128, 0 );
		//Do Stuff, fire some bullets or something.
		wait( 400 );

		T_Create_Pillar( GetStgFrameWidth(), GetStgFrameHeight(), 0, GetStgFrameWidth()/2 - 128, GetStgFrameWidth()/2 - 32, 0 );
		//Do Stuff, fire some bullets or something.
		wait( 400 );		

	}
}	

task T_Create_Pillar( X, Y, Angle, X_Dest_Left, X_Dest_Right, Y_Offset ) {

	let Laser_Start = ShotR1( X, Y, 0, 0, Angle, SHOT_ORB_RED, 160, SHOT_ORB_RED );
	let Laser_End = ShotR1( X, Y, 0, 0, Angle, SHOT_ORB_RED, 160, SHOT_ORB_RED );

	let Laser_Start_B = ShotR1( 0, Y, 0, 0, Angle, SHOT_ORB_RED, 160, SHOT_ORB_RED );
	let Laser_End_B = ShotR1( 0, Y, 0, 0, Angle, SHOT_ORB_RED, 160, SHOT_ORB_RED );

	T_Manage_CageWall( Laser_Start, Laser_End, 0, X_Dest_Left );
	T_Manage_CageWall( Laser_Start_B, Laser_End_B, GetStgFrameWidth(), X_Dest_Right );

	async{
		
		wait( 160 );

		float Bounce_Count = 1;
			
		/*
		loop( 10 ){

			//float Bounce_Count = 1;

			ascent (i in 0..24) {
				ascent (a in 0..1) {

					let Bouncy_Shot_A = ShotR1( bossX, bossY, 32, 1, i * 360/24 + a * 8/1, SHOT_SEIJA_FIREBALL_BLUE, 0, SHOT_ORB_RED );
					//T_BulletTrail( Bouncy_Shot_A, CC_ORANGE, 2, SHOT_SEIJA_FIREBALL_RED, 0.5 );
					T_Manage_Collision( Laser_Start, Laser_End, Bouncy_Shot_A, Bounce_Count );
					T_Manage_Collision( Laser_Start_B, Laser_End_B, Bouncy_Shot_A, Bounce_Count );

					// do something

				}

				wait( 10 );
			}

			Bounce_Count = 1;

			wait( 10 );
		}	
		*/

		task T_Manage_Collision( Laser_Start, Laser_End, Shot_Obj, Bounce_Count){
			
			//ObjShot_SetIntersectionEnable( Star_End_B, false );
			//let Connector = CreateStraightLaserA1(  ObjMove_GetX( Dummy_Shot ), ObjMove_GetY( Dummy_Shot ), Angle, 512, 32, 99999, SHOT_LASER_RED, 10 );	
			//let Laser_End_Dummy = ShotA1( ObjMove_GetX( Dummy_Shot ), ObjMove_GetY( Dummy_Shot ) - 64, 0, 0, SHOT_ORB_RED, 1 );		
			
			//ObjShot_SetAutoDelete(  Laser_End, false );
			
			//ObjStLaser_SetSource( Connector, false );

			//int Bounce_Count = 0;
			int[] Shot_Bounce_Colors = [ SHOT_BALL_BLUE, SHOT_BALL_YELLOW, SHOT_BALL_RED, SHOT_BALL_RED ];
			
			async{

				Obj_SetValue( Shot_Obj , "Bounced", false );
 
				//int Bounce_Colors = 0;
				//ObjShot_SetGraphic( Shot_Obj, Shot_Bounce_Colors[ 0 ] );
				
				while( !Obj_IsDeleted( Laser_Start ) ){
					
					let Intersection = IsIntersected_Point_Line( ObjMove_GetX( Shot_Obj ), ObjMove_GetY( Shot_Obj ),  ObjMove_GetX( Laser_Start ), ObjMove_GetY( Laser_Start ), ObjMove_GetX( Laser_End ), ObjMove_GetY( Laser_End ), 32  );			

					if( Intersection == true && Obj_GetValue( Shot_Obj, "Bounced") == false ){ 
					
						Bounce_Count -= 1;
						Obj_SetValue( Shot_Obj, "Bounced", true );
						//Bounce_Colors += 1;
						ObjMove_AddPatternA2( Shot_Obj, 1, 0, GetAngleToPlayer( Shot_Obj ), 0.01, 8 , 0 );
						//ObjMove_SetSpeed( Shot_Obj, ObjMove_GetSpeed( Shot_Obj ) + 0.3 );
						//ObjMove_SetAngle( Shot_Obj, GetAngleToPlayer( Shot_Obj ) + rand( -5, 5 ) ); 
						ObjShot_SetGraphic( Shot_Obj, SHOT_SEIJA_FIREBALL_RED );
						//T_BulletTrail( Shot_Obj, CC_ORANGE, 3, SHOT_BALL_RED, 1 );
						//if( Bounce_Count < 0 ){ T_DeleteShot_Effect( Shot_Obj ); Obj_Delete( Shot_Obj ); break; }
						//wait( 30 );
						break;
					
					}	

					yield;
				}						
				
			}			
			
			
		}	
		
		task T_Check_Intersection( Obj, Laser_End_Dummy ){
		
			let Intersection = IsIntersected_Point_Line( ObjMove_GetX( Obj ), ObjMove_GetY( Obj ),  ObjMove_GetX( Laser_Start ), ObjMove_GetY( Laser_Start ), ObjMove_GetX( Laser_End ), ObjMove_GetY( Laser_End ), 32  );
			if( Intersection == true ){ 
				
				ShotA1( ObjMove_GetX( Obj ), ObjMove_GetY( Obj ), 2, ObjMove_GetAngle( Obj ) +180, SHOT_ORB_BLUE, 10 );
				//break;
				//ObjMove_SetAngle( Obj, ObjMove_GetAngle( Obj ) - 180 ); 
				wait( 60 );
					
			}
			
		}			
	
	}

	task T_BulletTrail( Obj, Color, Rate, Graphic, Size ){

		while( !Obj_IsDeleted( Obj )){

			//int Shot_Name_A = ShotR1( ObjMove_GetX(Obj), ObjMove_GetY(Obj), 0, 1,  ObjMove_GetAngle(Obj) + 180 + rand( -32, 32 ), SHOT_BALL_PURPLE, 0, SHOT_BALL_PURPLE );
			//ObjRender_SetBlendType( Shot_Name_A, BLEND_ADD_ARGB );
			//ObjRender_SetColor( Shot_Name_A, 255, 255, 255 );
			//ObjShot_SetDeleteFrame( Shot_Name_A, 1 );

			int Shot_Name_B = ShotR1( ObjMove_GetX(Obj), ObjMove_GetY(Obj), 0, 1,  ObjMove_GetAngle(Obj) + 180 + rand( -32, 32 ), Graphic, 0, Graphic );
			ObjRender_SetBlendType( Shot_Name_B, BLEND_ADD_ARGB );
			ObjRender_SetColor( Shot_Name_B, Color[0], Color[1], Color[2] );
			T_ManageTrail_Obj( Shot_Name_B );
			ObjShot_SetDeleteFrame( Shot_Name_B, 1 );	
			ObjShot_SetIntersectionEnable( Shot_Name_B, false );

			wait( Rate );
		}

		task T_ManageTrail_Obj( Trail_Shot ){

			ascent (i in 0..20) {
				
				ObjRender_SetScaleXYZ( Trail_Shot, Size - i * Size/20, Size - i * Size/20, Size - i * Size/20 );

				yield;
			}

		}


	}	


	task T_Manage_CageWall( Start, End, Init_X, Offset ){

		float Time = 120;

		async{

			let Connector = CreateStraightLaserA1(  ObjMove_GetX( Start ), ObjMove_GetY( Start ), 0, 0, 24, 99999, SHOT_LASER_AQUA, 1 ); 
			ObjShot_SetSpellResist( Start, true );
			ObjShot_SetAutoDelete( Start, false );	

			ObjShot_SetSpellResist( End, true );
			ObjShot_SetAutoDelete( End, false );			

			ObjShot_SetAutoDelete( Connector, false );	

			while( !Obj_IsDeleted( Start ) || !Obj_IsDeleted( End ) ){

				if( Obj_IsDeleted( End ) ){ break; }
				if( Obj_IsDeleted( Start ) ){ break; }
				
				//ObjMove_SetPosition( Prifma_Connector, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
				//ObjStLaser_SetAngle( Prifma_Connector, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), bossX, bossY ) );
				//ObjLaser_SetLength( Prifma_Connector, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), bossX, bossY ) + 1 );							
							
				//ObjMove_SetPosition( Prism, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 			
				ObjMove_SetPosition( Connector, ObjMove_GetX( Start ), ObjMove_GetY( Start ) ); 
				ObjStLaser_SetAngle( Connector, dottheta( ObjMove_GetX( Start ), ObjMove_GetY( Start ), ObjMove_GetX( End ), ObjMove_GetY( End ) ) );
				ObjLaser_SetLength( Connector, distance( ObjMove_GetX( Start ), ObjMove_GetY( Start ), ObjMove_GetX( End ), ObjMove_GetY( End ) ) + 1 );	

				yield;
			}

            if( !Obj_IsDeleted( Connector ) ){
                descent (a in 0..8) {

                    float Laser_Angle = ObjStLaser_GetAngle( Connector );
                    float Laser_Length = ObjLaser_GetLength( Connector );

                    float X_Pos = ObjMove_GetX( Connector );
                    float Y_Pos = ObjMove_GetY( Connector );   

                    float Shot_X = X_Pos + a * Laser_Length/8 * cos( Laser_Angle );
                    float Shot_Y = Y_Pos + a * Laser_Length/8 * sin( Laser_Angle );       
                    ascent (i in 0..5) {
                        
                        int ShotObj_A = ShotA2( Shot_X, Shot_Y, 0, Laser_Angle + 90 - 45, SHOT_SCALE_DAQUA, 10, DELAY_CLOUD_AQUA );
                        int ShotObj_B = ShotA2( Shot_X, Shot_Y, 0, Laser_Angle - 90 + 45, SHOT_SCALE_DAQUA, 10, DELAY_CLOUD_AQUA );
                        //T_Manage_SubShot( ShotObj_A );
                        ObjMove_AddPatternA2( ShotObj_A, 10, 2, NO_CHANGE, -0.1, 0.5 + i * 0.5/5,0 );
                        ObjMove_AddPatternA2( ShotObj_B, 10, 2, NO_CHANGE, -0.1, 0.5 + i * 0.5/5,0 );

                        ObjMove_AddPatternB2( ShotObj_A, 30, NO_CHANGE, NO_CHANGE, NO_CHANGE, 0.01, NO_CHANGE, 1 + i * 0.5/6 );
                        ObjMove_AddPatternB2( ShotObj_B, 30, NO_CHANGE, NO_CHANGE, NO_CHANGE, 0.01, NO_CHANGE, 1 + i * 0.5/6 );
                    }    

                    wait( 6 );
    
                }
            }    			


			Obj_Delete( Connector );			


		}
		
		ascent( i in 0..30 ){
			
			//ObjMove_SetX( Start, Interpolate_Smoother( X, Init_X, i/Time ));
			ObjMove_SetY( Start, Interpolate_Smoother( GetStgFrameHeight(), Y, i/30 ));

			//ObjMove_SetX( End, Interpolate_Smoother( bossX, Init_X, i/Time ));
			ObjMove_SetY( End, Interpolate_Smoother( GetStgFrameHeight(), 0, i/30 ));			
				
			yield;
		}		
	
	
		wait( Time*1.5 );
		
		ascent( i in 0..400 ){
			
			ObjMove_SetX( Start, Interpolate_Smoother( Init_X, Offset, i/400 ));
			ObjMove_SetX( End, Interpolate_Smoother( Init_X, Offset, i/400 ));
			//ObjMove_SetY( Dummy_Shot, Interpolate_Linear( Y, Get_CenterY, i/1000 ));
				
			yield;
		}	    

		Obj_Delete( Start );	
		Obj_Delete( End );

	}
}	

//-----------------------------------------------------Death---------------------------------------------------------

task T_End {
	
    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
	     yield;
	}
	
	if( ObjEnemyBossScene_GetInfo( GetEnemyBossSceneObjectID, INFO_IS_LAST_STEP ) ){

		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		
		yield;
		
		SetAutoDeleteObject(true);
		T_Boss_Shotdown( bossObj, "Petal", CC_CYAN );
		wait( 200 );
		
		Obj_Delete( bossObj );	
		
		//lol
		ENEMY_CLEAR = true;
		
		yield;
		
		ENEMY_CLEAR = false;
		
		wait( 800 );
		
		CloseScript( GetOwnScriptID() );
		
	}	
	else{
	
		NotifyEventAll( EV_SPAWN_ITEM_NON, bossX, bossY, 38, 64 );	
		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		//DeleteShotAll( TYPE_ALL, TYPE_ITEM );
		
		yield;
		
		SetAutoDeleteObject( true );
		
		Obj_Delete( bossObj );	
		
		wait( 60 );
		
		//DeleteShotAll(TYPE_ALL, TYPE_ITEM);
		
		CloseScript( GetOwnScriptID() );
	
	}
	
	//SetAutoDeleteObject(true);
	
	//Obj_Delete( bossObj );	
	//CloseScript( GetOwnScriptID() );
	
}

