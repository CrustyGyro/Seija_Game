#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Toyohime_Spell_01"]
//#Background["./Stage/BG/STG_00.dnh"];
#Player[ "./Player/PL_Reimu.dnh" ]
#System["./System/System_Main_Hud.dnh"]

//--------------------------------------------------Variables------------------------------------------------------

let bossObj;
let objScene = GetEnemyBossSceneObjectID();
let bossX = 0;
let bossY = 0;

//SetIntersectionVisualization( true );

let BossTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Test_Boss.png";

//---------------------------------------------------Include-------------------------------------------------------

	#include "./lib/Index_Boss.dnh"
	#include "./lib/Lib_Spell.dnh"
	#include "./lib/Lib_SpellCutin.dnh"	

//----------------------------------------------------Start--------------------------------------------------------

@Initialize {

	bossObj = ObjEnemy_Create(OBJ_ENEMY_BOSS);	
	
	ObjEnemy_Regist( bossObj );	

	T_Lifebar( bossObj );
    T_HitEffect( bossObj );
	ObjEnemy_SetDamageRate( bossObj, 0, 0 );	

	Init_Boss_Toyohime( bossObj );

	ObjRender_SetTextureFilter( bossObj, FILTER_NONE, FILTER_NONE, FILTER_NONE );
	
	ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2, Get_CenterY/2 + 16, 15, 8 );
	
	
	//SetPlayerLife( 8 );
	T_Main;
	T_End;
	
}

@Event { 

	alternative(GetEventType()) 
	case( EV_REQUEST_LIFE ) { 
		SetScriptResult( 750 ); // 3000-4500 For Nons ( At 100% Damage Rate. )
	}
	case( EV_REQUEST_TIMER ) { 
		SetScriptResult( 45 ); //40-50 For standard Nons.
	}	


} 

@MainLoop {

	bossX = ObjMove_GetX( bossObj );
	bossY = ObjMove_GetY( bossObj );
	
	SetCommonData( "Effect_X", bossX );
	SetCommonData( "Effect_Y", bossY );	

	ObjEnemy_SetIntersectionCircleToShot( bossObj, bossX, bossY, 16 );
	ObjEnemy_SetIntersectionCircleToPlayer( bossObj, bossX, bossY, 8 );
	
	yield;
}

@Finalize {
} 

task T_InitSpell(){
	
	//let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/CurseOfRa.png";
	
	T_CallSpell_A1( "Connection: \"Lambent Tideshifter\"", 0, "Normal", objScene );
	//T_Call_Spell_Cutin( CutinTex, [ 0, 0, 200, 384 ], 1, CC_ORANGE );	
	
	ObjEnemyBossScene_StartSpell( objScene );
	
	yield;
	//T_SpellBG_Nareko();	
	
}	

//----------------------------------------------------Patterns--------------------------------------------------------

task T_Main {


	//NotifyEventAll( EV_BOSS_EFFECT, bossObj, CC_RED );
	
	//let Color = [ DOT_GRAY, DOT_RED, DOT_YELLOW, DOT_CYAN, DOT_PURPLE, DOT_GREEN ];

	yield;

	wait( 45 );	
	
	T_PlaySE( SE_CHARGE_00, 30 );
	T_Charge_A1( bossObj, 20, "Petal", CC_PINK );

	wait( 34 );	
	
	//T_InitSpell();

	//wait( 34 );	

	ObjEnemy_SetDamageRate( bossObj, 0.18, 0.18 );
   // T_BossShot_C;
	//T_BossShot_B;

	while( Boss_Is_Alive( bossObj ) ){
		
		//Do Stuff, fire some bullets or something.
		yield;

	}
}	

task T_BossShot_C(){

	int Shot_Count_I = 100;
	float Base_Angle = 0;
	float Frame = 0;
	float Dir = 0.05;

	while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {

        ascent (a in 0..Shot_Count_I) {

            //T_PlaySE( SE_SHOT_03, 36 );
            ascent (b in 0..3) {
				let Shot_A = ShotR2( bossX, bossY, 128 + 8 * sin( Frame ), 32 + 8 * sin( Frame ), 0 , 0 + a * 360/Shot_Count_I, SHOT_SCALE_PINK, 10, SHOT_CLOUD_PINK );
				//T_ShotManage_A( Shot_A );
				//SObjMove_AddPatternA2( Shot_A, 60, 1, 90, 0.01, 1, Dir );
				ObjMove_AddPatternA2( Shot_A, 20, NO_CHANGE, NO_CHANGE, 0.01 + b*0.005/3, 3 + b*0.05/3, Dir );
			}

			Frame += 32;

			//yield;
        }

		//Base_Angle += 1;
		wait( 20 );

		Dir = -Dir;
		
		wait( 20 );
	}

}

task T_BossShot_B(){

	float Frame = 0;


	while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {

		ascent (i in 0..64) {
			ascent (a in 0..2) {
				let Shot_A = ShotR1( bossX, bossY, 64, 2, 90 + i * 360/64 + a * 360/2, SHOT_DDP_STAR_BLUE, 10, SHOT_DDP_STAR_BLUE );
				ObjMove_AddPatternA2( Shot_A, 60, NO_CHANGE, NO_CHANGE, -0.05, 1, 0 );
				ObjMove_SetAngle( Shot_A, GetAngleToPlayer( Shot_A )  + 8 * sin( Frame ));

			}
			Frame += 96;

			wait( 18 );
		}
	
		yield;

	}

}

task T_BossShot_A(){

    float Base_Angle = 0;
	float Dir = 0.05;
	float Offset_Y = 32;
	int Shot_Count_I = 3;

    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {

        ascent (a in 0..14) {

            T_PlaySE( SE_SHOT_03, 36 );
            
            ascent (i in 0..Shot_Count_I) {
            
                let Shot_A = ShotR1( a * GetStgFrameWidth()/6, 16, 0, 0.5 + i * 1/Shot_Count_I , 90 + i * 38/Shot_Count_I, SHOT_DROP_DMAGENTA, 10, SHOT_CLOUD_PINK );
				//T_ShotManage_A( Shot_A );
				ObjMove_AddPatternA2( Shot_A, 60, 1, 90, 0.01, 1, Dir );
				//ObjMove_AddPatternA2( Shot_A, 120, NO_CHANGE, NO_CHANGE, 0.01, 1.3, Dir );
                
            }

            descent (i in 0..Shot_Count_I) {
            
                let Shot_A = ShotR1( a * GetStgFrameWidth()/6, 16, 0, 0.5 + i * 1/Shot_Count_I , 90 - i * 38/Shot_Count_I, SHOT_DROP_BLUE, 10, SHOT_CLOUD_PINK );
				//T_ShotManage_A( Shot_A );
				ObjMove_AddPatternA2( Shot_A, 60, 1, 90, 0.01, 1, Dir );
				//ObjMove_AddPatternA2( Shot_A, 120*2, NO_CHANGE, NO_CHANGE, 0.01, 1.3, Dir );
                
            }			

            Base_Angle += 20;

            //wait( 8 );

        }

        wait( 20 );

        //ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2 + rand( - 32, 32 ), Get_CenterY/2 + 16, 15, 8 );

		Dir = -Dir;
        wait( 60 );

        ascent (a in 0..14) {

            T_PlaySE( SE_SHOT_03, 36 );
            
            ascent (i in 0..Shot_Count_I) {
            
                let Shot_A = ShotR1( a * GetStgFrameWidth()/6, 16, 0, 0.5 + i * 1/Shot_Count_I , 90 + i * 38/Shot_Count_I, SHOT_DROP_DMAGENTA, 10, SHOT_CLOUD_PINK );
				//T_ShotManage_A( Shot_A );
				ObjMove_AddPatternA2( Shot_A, 60, 1, 90, 0.01, 1, Dir );
				//ObjMove_AddPatternA2( Shot_A, 120*2, NO_CHANGE, NO_CHANGE, 0.01, 1.3, Dir );
                
            }

            descent (i in 0..Shot_Count_I) {
            
                let Shot_A = ShotR1( a * GetStgFrameWidth()/6, 16, 0, 0.5 + i * 1/Shot_Count_I , 90 - i * 38/Shot_Count_I, SHOT_DROP_BLUE, 10, SHOT_CLOUD_PINK );
				ObjMove_AddPatternA2( Shot_A, 60, 1, 90, 0.01, 1, Dir );
				//T_ShotManage_A( Shot_A );
				//ObjMove_AddPatternA2( Shot_A, 120, NO_CHANGE, NO_CHANGE, 0.01, 1.3, Dir );
                
            }			

            Base_Angle += 20;

            //wait( 8 );

        }

        wait( 20 );

       // ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2 + rand( - 32, 32 ), Get_CenterY/2 + 16, 15, 8 );

		Dir = -Dir;
        wait( 60 );		

    }

	task T_ShotManage_A( Obj ){

		while( ObjMove_GetY( Obj ) <= GetStgFrameHeight() - 16 ){

			yield;

		}

		ObjMove_AddPatternA2( Obj, 1, -2, 90 + rand( -45, 45 ), 0.08, 3, rand( -1,1 ) );

		//ObjMove_AddPatternB2( Obj, 1, rand( -1, 1 ), rand( -2 ), rand( -0.5, 0.5 ), 0.5, 0, 4 );


	}

}

//-----------------------------------------------------Death---------------------------------------------------------

task T_End {
	
    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
	     yield;
	}
	
	if( ObjEnemyBossScene_GetInfo( GetEnemyBossSceneObjectID, INFO_IS_LAST_STEP ) ){

		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		
		yield;
		
		SetAutoDeleteObject(true);
		T_Boss_Shotdown( bossObj, "Petal", CC_RED );
		wait( 200 );
		
		Obj_Delete( bossObj );	
		
		ENEMY_CLEAR = true;
		
		yield;
		
		ENEMY_CLEAR = false;
		
		wait( 500 );
		
		CloseScript( GetOwnScriptID() );
		
	}	
	else{
	
	
		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		//DeleteShotAll( TYPE_ALL, TYPE_ITEM );
		
		yield;
		
		SetAutoDeleteObject(true);
		
		Obj_Delete( bossObj );	
		
		wait( 500 );
		
		CloseScript( GetOwnScriptID() );
	
	}
	
	//SetAutoDeleteObject(true);
	
	//Obj_Delete( bossObj );	
	//CloseScript( GetOwnScriptID() );
	
}

