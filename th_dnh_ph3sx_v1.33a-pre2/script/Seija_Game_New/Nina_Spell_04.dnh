	wait( 60 );    

	//ObjEnemy_SetDamageRate( bossObj, 0.3, 0.3 );
	
	T_Boss_Shot_A;
	
	//T_Boss_Shot_B();
	
	wait( 240 );

    ObjEnemy_SetDamageRate( bossObj, 0.3, 0.3 );

