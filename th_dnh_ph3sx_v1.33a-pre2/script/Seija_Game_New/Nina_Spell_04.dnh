	//NotifyEventAll( EV_BOSS_EFFECT, bossObj, CC_PINK );
	//T_Shoot_Banner( "Watari Nina", CC_PINK, 40 );

	wait( 60 );

	T_PlaySE( SE_CHARGE_00, 30 );
	T_Charge_A1( bossObj, 20, "Petal", CC_PINK );

	wait( 40 );    

	T_InitSpell();
	
	wait( 60 );    

	//ObjEnemy_SetDamageRate( bossObj, 0.3, 0.3 );
	
	T_Boss_Shot_B;
    //T_Movement_A;
	
	//T_Boss_Shot_B();
	
	wait( 240 );

    ObjEnemy_SetDamageRate( bossObj, 0.3, 0.3 );

	/*
	while ( !Obj_IsDeleted( bossObj )) {
		// do something
		ascent (a in 0..4) {
			ascent (i in 0..180) {

				let Laser_A = Laser_A1( ObjMove_GetX( bossObj ), ObjMove_GetY( bossObj ), 90 + i * 360/180 + a * 45/4, 512, 14, 12, SHOT_LASER_DYELLOW, 8 );
				wait( 4 );
			}

			//wait( 4 );
		}	
		wait( 4 );
	}
	*/
	//T_Boss_Shot_D();
	//T_Movement_A( );
	
}	

task T_Movement_A{

	float X = 0;
	float Y = 0;
	
	while( Boss_Is_Alive( bossObj ) ){

		ObjMove_SetDestAtWeight( bossObj, bossX + 32 * cos( X ), bossY + 32 * sin( Y ), 64, 3 );
		X += 1;
		Y += 1;
		
		yield;
	}

}

task T_Boss_Shot_B{

    float Dir = -0.2;
    float Dir_Spawn = 100;
    float Pentacle_Radius = 256; //244;
    float Pentacle_Bullet_Delay = 300;
    float Shrink_Time = 300;
    float Spawn_Time = 300;


    T_Create_Pentacle( bossObj, GetStgFrameWidth()/2, GetStgFrameHeight()/2 - 32, 0, 360, 90, Dir, Pentacle_Radius, Pentacle_Bullet_Delay);

    Dir = -Dir;
    Dir_Spawn = -Dir_Spawn;
    wait( 900 );

    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){ 
        
        T_Create_Pentacle( bossObj, GetStgFrameWidth()/2 + Dir_Spawn, GetStgFrameHeight()/2 - 32, 0, 360, 90, Dir, Pentacle_Radius, Pentacle_Bullet_Delay);

        Dir = -Dir;
        Dir_Spawn = -Dir_Spawn;
        wait( 800 );

    }

    task T_Create_Pentacle( Parent, X, Y, Speed, Angle, Initial_Angle, Dir, Radius, Delay ){

        int Way_Star = 5;
        int Way_Outer = 12;
        int Stack = 1;
        bool Transform_Bullet = false;

        ObjMove_SetDestAtFrame( Parent, X, Y, 120, LERP_SMOOTHER );

        wait( 120 );

    	T_PlaySE( SE_CHARGE_00, 30 );
	    T_Charge_A1( bossObj, 20, "Petal", CC_RED );    

        wait( 60 );        

        T_PlaySE( SE_BURST_00, 30 );
        T_Charge_Burst_A( Parent, "Petal", CC_RED );

        wait( 10 );

        async {
            
            wait( Shrink_Time*1.8 );
            T_PlaySE( SE_CHARGE_00, 30 );
            T_Charge_A1( bossObj, 20, "Petal", CC_RED );    

            wait( 60 );   

        }

        ObjMove_SetDestAtFrame( Parent, GetStgFrameWidth()/2, GetStgFrameHeight()/2, Shrink_Time*2, LERP_SMOOTHER );
        /*
        if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){ 
            ascent (a in 0..10) {
                ascent (b in 0..2){
                    ascent (i in 0..12){
                        if( i % 2 == 0 ){

                            int Fire_Burst_A = ShotA2( bossX, bossY, 0.2 + i * 1.5/12 , 90 + a * 360/10 + b * 6/2, SHOT_SCALE_DBLUE, 20, DELAY_CLOUD_PINK );    
                            //int Fire_Burst_B = ShotA2( bossX, bossY, 0.2 + i * 1.5/12 , 90 + a * 360/32, SHOT_DOT_BLUE, 32, DELAY_CLOUD_PINK );                    
                        }
                        else{
                            int Fire_Burst_A = ShotA2( bossX, bossY, 0.2 + i * 1.5/12 , 90 + a * 360/10 + b * 6/2, SHOT_SCALE_PURPLE, 20, DELAY_CLOUD_PINK );
                            //int Fire_Burst_B = ShotA2( bossX, bossY, 0.2 + i * 1.5/12 , 90 + a * 360/32, SHOT_DOT_PURPLE, 32, DELAY_CLOUD_PINK ); 
                        }    
                        //int Fire_Burst_B = ShotA2( bossX, bossY, 0.5 + i * 0.5/8 , 90 + a * 360/32, SHOT_FIREBALL_BLUE, 20, SHOT_FIREBALL_BLUE );
                        //int Fire_Burst_A = ShotA2( bossX, bossY, 0.5 + i * 1.5/8 , 90 + a * 360/32, SHOT_BILL_DBLUE, 20, SHOT_FIREBALL_BLUE );
                        //int Fire_Burst_B = ShotA2( bossX, bossY, 0.5 + i * 3/6 , 90 + a * 360/24 + 24, SHOT_FIREBALL_BLUE, 20, SHOT_FIREBALL_BLUE );
                    }
                }
            }        
        }
        */
        int[] Connector_Shots = Pattern_Shot_A1( X, Y, 0, Radius, 360, 360, SHOT_ORB_RED, PATTERN_RING, Way_Star, Stack, 0, SHOT_ORB_RED );
        int[] Circular_Shots = Pattern_Shot_A1( X, Y, 0, Radius, 360, 360, SHOT_ORB_RED, PATTERN_RING, Way_Outer, Stack, 0, SHOT_ORB_RED );

        //The Star
        T_Pentacle_Laser_A( Connector_Shots[0], Connector_Shots[2], SHOT_LASER_RED, 10 );	
        T_Pentacle_Laser_A( Connector_Shots[2], Connector_Shots[4], SHOT_LASER_RED, 10 );	
        T_Pentacle_Laser_A( Connector_Shots[4], Connector_Shots[1], SHOT_LASER_RED, 10 );	
        T_Pentacle_Laser_A( Connector_Shots[1], Connector_Shots[3], SHOT_LASER_RED, 10 );	
        T_Pentacle_Laser_A( Connector_Shots[3], Connector_Shots[0], SHOT_LASER_RED, 10 );	 

        for( int a = 0; a < Way_Star * Stack; a++ ) {

            T_Rotate_Pentagram( Parent, Connector_Shots[a], Radius, 360, Spawn_Time, Dir, false, Spawn_Time );

        }    


        for( int a = 0; a < Way_Outer * Stack; a++ ) {

            T_Rotate_Pentagram( Parent, Circular_Shots[a], Radius, Initial_Angle, Spawn_Time, -Dir, true, Spawn_Time );
            //T_Rotate_Pentagram( Parent, Circular_Shots[ a ], Radius, 90, 300, -Dir, true  );

            if( a < Way_Outer-1 ){
                    
                if( a % 2 == 0){ 
                    T_Pentacle_Laser_A( Circular_Shots[a], Circular_Shots[a+1], SHOT_LASER_RED, Spawn_Time );
                }   
                else{
                    T_Pentacle_Laser_A( Circular_Shots[a], Circular_Shots[a+1], SHOT_LASER_DBLUE, Spawn_Time );
                }

            }
            else{
                    
                T_Pentacle_Laser_A( Circular_Shots[ Way_Outer-1], Circular_Shots[0], SHOT_LASER_DBLUE, Spawn_Time );

            }			

        }            


        task T_Pentacle_Laser_A( Shot, Next_Shot, Laser_Color, Laser_Delay ){

            wait( 1 );            

           // let Connector_Dark = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 28, 99999, SHOT_LASER_GREY, 200 );
            let Connector = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 16, 99999, Laser_Color, Laser_Delay );
            let Connector_Dark = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 32, 99999, SHOT_CURVY_LASER_GREY, Laser_Delay );
            //ObjRender_SetAlpha( Shot, 0 );
            //ObjRender_SetAlpha( Next_Shot, 0 );
            ObjShot_SetSpellResist( Shot, true );
            ObjShot_SetAutoDelete( Shot, false );		

            Obj_SetRenderPriorityI( Connector, Obj_GetRenderPriorityI( Connector ) + 1 );
            ObjShot_SetAutoDelete( Connector, false );	
            ObjStLaser_SetSource( Connector, false );

            ObjRender_SetBlendType( Connector_Dark, BLEND_SUBTRACT );
            Obj_SetRenderPriorityI( Connector_Dark, Obj_GetRenderPriorityI( Connector ) - 1 );
            ObjLaser_SetIntersectionWidth( Connector_Dark, 0 );
            ObjShot_SetAutoDelete( Connector_Dark, false );	
            ObjStLaser_SetSource( Connector_Dark, false );    
            
            async {

                while( Transform_Bullet == false ){ yield; }
                //wait( Spawn_Time );

                ObjLaser_SetIntersectionWidth( Connector, 0 );

                float L_Width = 16;

                T_PlaySE( SE_SPECIAL_00, 30 );

                ascent ( i in 0..30 ) {
                    L_Width -= 16/30;	

                    ObjLaser_SetRenderWidth( Connector , L_Width );
                    ObjLaser_SetRenderWidth( Connector_Dark , L_Width + 16 );
                    ObjRender_SetColor( Connector, 255, 255 - i * 200/30, - i * 200/30 );


                    yield;
                }

                if( !Obj_IsDeleted( Connector ) ){
                    ascent (a in 0..10) {

                        float Laser_Angle = ObjStLaser_GetAngle( Connector );
                        float Laser_Length = ObjLaser_GetLength( Connector );

                        float X_Pos = ObjMove_GetX( Connector );
                        float Y_Pos = ObjMove_GetY( Connector );   

                        float Shot_X = X_Pos + a * Laser_Length/10 * cos( Laser_Angle );
                        float Shot_Y = Y_Pos + a * Laser_Length/10 * sin( Laser_Angle );       

                        int ShotObj_A = ShotA2( Shot_X, Shot_Y, 0, Laser_Angle + 90, SHOT_BALL_AURA_DRED, 10, SHOT_BALL_AURA_DRED );
                        T_Manage_SubShot( ShotObj_A );
                        ObjMove_AddPatternA2( ShotObj_A, 200, 0, Laser_Angle - 90 + rand( -45, 45 ), 0.01, 0.3 - a * 0.05/4,0 );
                        //T_Manage_Shot( ShotObj_A, 1 );

                        //wait( 4 );
                    }
                }
                task T_Manage_SubShot( Obj ){

                    async{
                        wait( rand( 1, 24 ) );
                         T_DeleteShot_Effect( Obj );


                    }

                    ascent (i in 0..200) {

                        ObjRender_SetColor( Obj, 255, 0 + i * 255/200, 0 + i * 255/200 );
                        yield;
                    }

                }

                Obj_Delete( Connector );
                Obj_Delete( Connector_Dark );

                Obj_Delete( Shot );
                Obj_Delete( Next_Shot );                
            }              
            
            async{
                while( !Obj_IsDeleted( Shot ) || !Obj_IsDeleted( Next_Shot ) ){

                                
                    if( Obj_IsDeleted( Next_Shot ) ){ break; }
                    if( Obj_IsDeleted( Shot ) ){ break; }
                    
                    //ObjMove_SetPosition( Prism, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 				
                                            
                    ObjMove_SetPosition( Connector, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
                    ObjStLaser_SetAngle( Connector, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) );
                    ObjLaser_SetLength( Connector, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) + 1 );	

                    ObjMove_SetPosition( Connector_Dark, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
                    ObjStLaser_SetAngle( Connector_Dark, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) );
                    ObjLaser_SetLength( Connector_Dark, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) + 1 );	                
                                
                    yield;
                }
                
                Obj_Delete( Connector );   
                Obj_Delete( Connector_Dark );
            }

        }  

        task T_Rotate_Pentagram( Parent, Shot, Radius, Initial_Angle, Time, Dir, Can_Shoot, Shot_Dleay ){

            //ObjShot_SetAutoDelete( Shot, false );
            //ObjShot_SetGraphic( Shot, Color_A );

            async {
                
                if( Can_Shoot == true ){
                    wait( Shot_Dleay );

                    while( !Obj_IsDeleted( Shot )){

                        int ShotObj_A = ShotR1( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 4, ObjMove_GetAngle(Shot) + rand( -45, 45 ), SHOT_KNIFE_RED, 10, SHOT_KNIFE_RED );
                        int ShotObj_B = ShotR1( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 4, ObjMove_GetAngle(Shot) + rand( -45, 45 ), SHOT_KNIFE_RED, 10, SHOT_KNIFE_RED );

                        wait( 5 );

                    }
                }
            }

            float Angle = dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Parent ), ObjMove_GetY( Parent ) );
            float Frame = 0;
            float Inital_Radius = 0;
                //float Angle_Init = 360;
                    
            ascent( i in 0..Time ){
                    
                if( Obj_IsDeleted( Parent ) ){  Obj_Delete( Shot ); }
                float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle );
                float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle );					
                                    
                        //Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
                Inital_Radius = Interpolate_Overshoot( 0, Radius, 1.5, i/Time );

                Angle+= Dir;	
    
                ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
                ObjMove_SetAngle( Shot, Angle );
                        
                yield;
                        
            }	

            while( !Obj_IsDeleted( Parent ) ){
                        
                float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle );
                float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle );					
                        
                Angle+= Dir;
                Dir -= Dir/Shrink_Time;		
                    //Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
                //Inital_Radius = Interpolate_Overshoot( 0, Radius, 2, i/Time );			
                Inital_Radius -= ( Radius/2 )/Shrink_Time;	
                if( Inital_Radius < Radius/2 ){ break; }
                
                ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
                ObjMove_SetAngle( Shot, Angle );
                        
                yield;
                        
            }	

            Transform_Bullet = true;
                
            ascent (i in 0..120){
                        
                float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle );
                float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle );					
                        
                Angle+= Dir;
                Inital_Radius = Interpolate_Smoother( Radius/2, Radius*0.8, i/120 );
               // Dir += 8/30;		
                    //Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
                //Inital_Radius = Interpolate_Overshoot( 0, Radius, 2, i/Time );			
                
                ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
                ObjMove_SetAngle( Shot, Angle );
                        
                yield;
                        
            }	                
            //Obj_Delete( Parent );
            Obj_Delete( Shot );
             
        }

    } 
} 

//-----------------------------------------------------Death---------------------------------------------------------

task T_End {
	
    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
	     yield;
	}
	
	if( ObjEnemyBossScene_GetInfo( GetEnemyBossSceneObjectID, INFO_IS_LAST_STEP ) ){

		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		
		yield;
		
		SetAutoDeleteObject(true);
		T_Boss_Shotdown( bossObj, "Petal", CC_CYAN );
		wait( 200 );
		
		Obj_Delete( bossObj );	
		
		//lol
		ENEMY_CLEAR = true;
		
		yield;
		
		ENEMY_CLEAR = false;
		
		wait( 800 );
		
		CloseScript( GetOwnScriptID() );
		
	}	
	else{
	
		NotifyEventAll( EV_SPAWN_ITEM_NON, bossX, bossY, 38, 64 );	
		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		//DeleteShotAll( TYPE_ALL, TYPE_ITEM );
		
		yield;
		
		SetAutoDeleteObject( true );
		
		Obj_Delete( bossObj );	
		
		wait( 60 );
		
		//DeleteShotAll(TYPE_ALL, TYPE_ITEM);
		
		CloseScript( GetOwnScriptID() );
	
	}
	
	//SetAutoDeleteObject(true);
	
	//Obj_Delete( bossObj );	
	//CloseScript( GetOwnScriptID() );
	
}

