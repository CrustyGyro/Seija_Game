}	

task T_Boss_Shot_A{

    float Angle_RNG = rand( 0, 360 );
    float Dir = -0.3;
    float Dir_Spawn = 120;
    float Shrink_Time = 300;

   // T_Create_Pentacle( GetStgFrameWidth()/2 + Dir_Spawn, bossY, 0, 90, 5, SHOT_CLOUD_RED, 90, 0.3 );


    T_Create_Pentacle( bossObj, GetStgFrameWidth()/2, GetStgFrameHeight()/2 - 32, 0, 90, 5, SHOT_CLOUD_RED, 90, Dir, 244 );
       // T_Create_Whatever( bossX, bossY, 0, 90, 5, SHOT_CLOUD_RED, 90, 1 );
    Dir = -Dir;
    Dir_Spawn = -Dir_Spawn;
    wait( 900 );

    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ){ 

    	//T_PlaySE( SE_CHARGE_00, 30 );
	   // T_Charge_A1( bossObj, 20, "Petal", CC_RED );        

        //wait( 30 );

        if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) <= 0 ){ break; }
            T_Create_Pentacle( bossObj, GetStgFrameWidth()/2 + Dir_Spawn, GetStgFrameHeight()/2 -32, 0, 90, 5, SHOT_CLOUD_RED, 90, Dir, 232 );
        // T_Create_Whatever( bossX, bossY, 0, 90, 5, SHOT_CLOUD_RED, 90, 1 );
            Dir = -Dir;
            Dir_Spawn = -Dir_Spawn;
        wait( 1000 );

    	//T_PlaySE( SE_CHARGE_00, 30 );
	   // T_Charge_A1( bossObj, 20, "Petal", CC_RED );   

        //wait( 30 );
        if( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) <= 0 ){ break; }
        T_Create_Pentacle( bossObj, GetStgFrameWidth()/2 + Dir_Spawn, GetStgFrameHeight()/2 -32, 0, 90, 5, SHOT_CLOUD_RED, 90, Dir, 232 );
       // T_Create_Whatever( bossX, bossY, 0, 90, 5, SHOT_CLOUD_RED, 90, 1 );
        Dir = -Dir;
        Dir_Spawn = -Dir_Spawn;
        wait( 1000 );       
        // T_Create_Whatever( bossX, bossY, 0, 90, 5, SHOT_CLOUD_RED, 90, 1 );


    }   

    task T_Create_Pentacle( Parent, X, Y, Speed, Angle, Count, Color_A, Initial_Angle, Dir, Radius ){

        int Way = Count;
        int Way_B = 12;
        int Stack = 1;
        //int Shot_Color = SHOT_BALL_DORANGE;
        //int Pentagram_Core = ShotA2( bossX, bossY, Speed,Angle, Color_A, 20, Color_A );

        ObjMove_SetDestAtFrame( Parent, X, Y, 120, LERP_SMOOTHER );

        wait( 240 );

    	T_PlaySE( SE_CHARGE_00, 30 );
	    T_Charge_A1( bossObj, 20, "Petal", CC_RED );    

        wait( 60 );        

        T_Charge_Burst_A( Parent, "Petal", CC_RED );
        
        ascent (a in 0..32) {
            ascent (i in 0..8){

                int Fire_Burst_B = ShotA2( bossX, bossY, 0.5 + i * 1.5/8 , 90 + a * 360/32, SHOT_FIREBALL_BLUE, 20, SHOT_FIREBALL_BLUE );
                int Fire_Burst_A = ShotA2( bossX, bossY, 0.5 + i * 1.5/8 , 90 + a * 360/32, SHOT_BILL_DBLUE, 20, SHOT_FIREBALL_BLUE );
                //int Fire_Burst_B = ShotA2( bossX, bossY, 0.5 + i * 3/6 , 90 + a * 360/24 + 24, SHOT_FIREBALL_BLUE, 20, SHOT_FIREBALL_BLUE );
            }

        }
        


        //wait( 120 );
        int[] Connector_Shots = Pattern_Shot_A1( X, Y, 0, 1, 360, 0, Color_A, PATTERN_RING, Way, Stack, 0, Color_A );
        int[] Circular_Shots = Pattern_Shot_A1( X, Y, 0, 224, 360, 0, Color_A, PATTERN_RING, Way_B, Stack, 0, Color_A );

        T_Manage_Laser_A( Connector_Shots[0], Connector_Shots[2] );		
        T_Manage_Laser_A( Connector_Shots[2], Connector_Shots[4] );	
        T_Manage_Laser_A( Connector_Shots[4], Connector_Shots[1] );	
        T_Manage_Laser_A( Connector_Shots[1], Connector_Shots[3] );	
        T_Manage_Laser_A( Connector_Shots[3], Connector_Shots[0] );	         

        for( int a = 0; a < Way * Stack; a++ ) {

            T_Rotate_Pentagram( Parent, Connector_Shots[ a ], Radius, 360, 300, Dir, false );
        }    

        for( int a = 0; a < Way_B * Stack; a++ ) {

            T_Rotate_Pentagram( Parent, Circular_Shots[ a ], Radius, 90, 300, -Dir, true  );

            if( a < Way_B-1 ){
                    
                T_Manage_Laser_B( Circular_Shots[a], Circular_Shots[a+1] );

            }
            else{
                    
                T_Manage_Laser_B( Circular_Shots[Way_B-1], Circular_Shots[0] );

            }			

        }

        ObjMove_SetDestAtFrame( Parent, GetStgFrameWidth/2, GetStgFrameHeight()/2, 600, LERP_SMOOTHER );
        /*
        ascent (i in 0..800) {
           
           ObjMove_SetPosition( Pentagram_Core, Interpolate_Smoother( X, GetStgFrameWidth()/2, i/800 ), Interpolate_Smoother( Y, GetStgFrameHeight()/2, i/800 ));
           
           yield;
        }
        */
                

        task T_Manage_Laser_A( Shot, Next_Shot ){

            wait( 2 );

           // let Connector_Dark = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 28, 99999, SHOT_LASER_GREY, 200 );
            let Connector = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 24, 99999, SHOT_LASER_RED, 200 );
            //let Connector_Dark = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 32, 99999, SHOT_LASER_PINK, 200 );
            //ObjRender_SetAlpha( Shot, 0 );
            //ObjRender_SetAlpha( Next_Shot, 0 );
            ObjShot_SetSpellResist( Shot, true );
            ObjShot_SetAutoDelete( Shot, false );		

            ObjShot_SetAutoDelete( Connector, false );	
            ObjStLaser_SetSource( Connector, false );

            //ObjRender_SetBlendType( Connector_Dark, BLEND_SUBTRACT );
            //Obj_SetRenderPriorityI( Connector_Dark, Obj_GetRenderPriorityI( Connector ) - 1 );
            //ObjLaser_SetIntersectionWidth( Connector_Dark, 0 );
            //ObjRender_SetColor( Connector_Dark, 0, 0, 0 );
            //ObjShot_SetAutoDelete( Connector_Dark, false );	
            //ObjStLaser_SetSource( Connector_Dark, false );            
            
            
            async{

                float X_Pos = 0;
                float Y_Pos = 0;
                float Laser_Angle = ObjStLaser_GetAngle( Connector );
                float Laser_Length = ObjLaser_GetLength( Connector );

                while( !Obj_IsDeleted( Connector )){

                    Laser_Angle = ObjStLaser_GetAngle( Connector );
                    Laser_Length = ObjLaser_GetLength( Connector );

				    X_Pos = ObjMove_GetX( Connector );
				    Y_Pos = ObjMove_GetY( Connector );                  

                    yield;

                }    

                ascent (a in 0..12) {

				    float Shot_X = X_Pos + a * Laser_Length/12 * cos( Laser_Angle );
					float Shot_Y = Y_Pos + a * Laser_Length/12 * sin( Laser_Angle );                    
                    /*
                    int ShotObj_A_Shadow = ShotA2( Shot_X, Shot_Y, 0, Laser_Angle + 90, SHOT_BALL_AURA_DRED, 0, SHOT_BALL_AURA_DRED );
                    ObjRender_SetColor( ShotObj_A_Shadow, 0, 0, 0 );
                    ObjRender_SetScaleXYZ( ShotObj_A_Shadow, 1.5, 1.5, 1.5 );
                    ObjShot_SetIntersectionEnable( ShotObj_A_Shadow, false );
                    ObjShot_SetDeleteFrame( ShotObj_A_Shadow, 80 );
                    */

                    int ShotObj_A = ShotA2( Shot_X, Shot_Y, 0, Laser_Angle + 90, SHOT_BALL_AURA_DRED, 10, SHOT_BALL_AURA_DRED );
                    ObjMove_AddPatternA2( ShotObj_A, 100, 0, GetAngleToPlayer( ShotObj_A ), 0.01, 0.5 + a*0.4/8,0 );
                    //T_Manage_Shot( ShotObj_A, 1 );

                    //wait( 4 );
                }


            }

            
            async {
                wait( 300 );

                float L_Width = 24;

                ascent ( i in 0..Shrink_Time ) {
                    L_Width -= 16/Shrink_Time;	

                    ObjLaser_SetRenderWidth( Connector , L_Width );
                    //ObjRender_SetColor( Connector, 255, 255 - i * 255/Shrink_Time, - i * 255/Shrink_Time );


                    yield;;
                }
            }            
            
            while( !Obj_IsDeleted( Shot ) || !Obj_IsDeleted( Next_Shot ) ){

                            
                if( Obj_IsDeleted( Next_Shot ) ){ break; }
                if( Obj_IsDeleted( Shot ) ){ break; }
                
                //ObjMove_SetPosition( Prism, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 				
                                        
                ObjMove_SetPosition( Connector, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
                ObjStLaser_SetAngle( Connector, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) );
                ObjLaser_SetLength( Connector, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) + 1 );	

                //ObjMove_SetPosition( Connector_Dark, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
                //ObjStLaser_SetAngle( Connector_Dark, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) );
                //ObjLaser_SetLength( Connector_Dark, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) + 1 );	                
                            
                yield;
            }
            
            Obj_Delete( Connector );   
            //Obj_Delete( Connector_Dark );
        }    

        task T_Manage_Laser_B( Shot, Next_Shot ){

            wait( 2 );

            //let Connector_Dark = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 28, 99999, SHOT_LASER_GREY, 200 );
            let Connector = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 24, 99999, SHOT_LASER_RED, 200 );
            //let Connector_Dark = CreateStraightLaserA1(  ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 1, 32, 99999, SHOT_LASER_PINK, 200 );
            //ObjRender_SetAlpha( Shot, 0 );
            //ObjRender_SetAlpha( Next_Shot, 0 );
            ObjShot_SetSpellResist( Shot, true );
            ObjShot_SetAutoDelete( Shot, false );		

            ObjShot_SetAutoDelete( Connector, false );	
            ObjStLaser_SetSource( Connector, false );
            /*
            ObjRender_SetBlendType( Connector_Dark, BLEND_SUBTRACT );
            Obj_SetRenderPriorityI( Connector_Dark, Obj_GetRenderPriorityI( Connector ) - 1 );
            //ObjRender_SetColor( Connector_Dark, 0, 0, 0 );
            ObjShot_SetAutoDelete( Connector_Dark, false );	
            ObjLaser_SetIntersectionWidth( Connector_Dark, 0 );
            ObjStLaser_SetSource( Connector_Dark, false );  
            */

            async{

                float X_Pos = 0;
                float Y_Pos = 0;
                float Laser_Angle = ObjStLaser_GetAngle( Connector );
                float Laser_Length = ObjLaser_GetLength( Connector );

                while( !Obj_IsDeleted( Connector )){

                    Laser_Angle = ObjStLaser_GetAngle( Connector );
                    Laser_Length = ObjLaser_GetLength( Connector );

				    X_Pos = ObjMove_GetX( Connector );
				    Y_Pos = ObjMove_GetY( Connector );                  

                    yield;

                }    

                ascent (a in 0..4) {

				    float Shot_X = X_Pos + a * Laser_Length/4 * cos( Laser_Angle );
					float Shot_Y = Y_Pos + a * Laser_Length/4 * sin( Laser_Angle );       

                    /*
                    int ShotObj_A_Shadow = ShotA2( Shot_X, Shot_Y, 0, Laser_Angle + 90, SHOT_BALL_AURA_DRED, 0, SHOT_BALL_AURA_DRED );
                    ObjRender_SetColor( ShotObj_A_Shadow, 0, 0, 0 );
                    ObjRender_SetScaleXYZ( ShotObj_A_Shadow, 1.5, 1.5, 1.5 );
                    ObjShot_SetIntersectionEnable( ShotObj_A_Shadow, false );
                    ObjShot_SetDeleteFrame( ShotObj_A_Shadow, 80 );                                 
                    */

                    int ShotObj_A = ShotA2( Shot_X, Shot_Y, 0, Laser_Angle + 90, SHOT_BALL_AURA_DRED, 10, SHOT_BALL_AURA_DRED );
                    ObjMove_AddPatternA2( ShotObj_A, 100, 0, Laser_Angle - 90 + rand( -45, 45 ), 0.01, 0.3 - a * 0.05/4,0 );
                    //T_Manage_Shot( ShotObj_A, 1 );

                    //wait( 4 );
                }


            } 

            async {
                wait( 300 );

                float L_Width = 24;

                ascent ( i in 0..Shrink_Time ) {
                    L_Width -= 16/Shrink_Time;	

                    ObjLaser_SetRenderWidth( Connector , L_Width );
                    //ObjRender_SetColor( Connector, 255, 255 - i * 255/Shrink_Time, - i * 255/Shrink_Time );


                    yield;;
                }
            }                         

            while( !Obj_IsDeleted( Shot ) || !Obj_IsDeleted( Next_Shot ) ){

                            
                if( Obj_IsDeleted( Next_Shot ) ){ break; }
                if( Obj_IsDeleted( Shot ) ){ break; }
                
                //ObjMove_SetPosition( Prism, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 				
                                        
                ObjMove_SetPosition( Connector, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
                ObjStLaser_SetAngle( Connector, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) );
                ObjLaser_SetLength( Connector, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) + 1 );	

               // ObjMove_SetPosition( Connector_Dark, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
               // ObjStLaser_SetAngle( Connector_Dark, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) );
               // ObjLaser_SetLength( Connector_Dark, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Next_Shot ), ObjMove_GetY( Next_Shot ) ) + 1 );	                
               //             
                yield;
            }
            
            //Obj_Delete( Connector_Dark );   
            Obj_Delete( Connector );   
        }          

        task T_Rotate_Pentagram( Parent, Shot, Radius, Initial_Angle, Time, Dir, Can_Shoot  ){

            //ObjShot_SetAutoDelete( Shot, false );
            //ObjShot_SetGraphic( Shot, Color_A );

            async {
                
                if( Can_Shoot == true ){
                    wait( 200 );

                    while( !Obj_IsDeleted( Shot )){

                        int ShotObj_A = ShotR1( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), 0, 4, ObjMove_GetAngle(Shot) + 45, SHOT_KNIFE_RED, 10, SHOT_KNIFE_RED );

                        wait( 3 );

                    }
                }
            }
                
            async{
                    
                float Angle = dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), ObjMove_GetX( Parent ), ObjMove_GetY( Parent ) );
                float Frame = 0;
                float Inital_Radius = 0;
                float Angle_Init = Initial_Angle;
                    
                ascent( i in 0..Time ){
                    
                    if( Obj_IsDeleted( Parent ) ){  Obj_Delete( Shot ); }
                    float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle );
                    float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle );					
                                    
                        //Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
                    Inital_Radius = Interpolate_Overshoot( 0, Radius, 1.5, i/Time );

                    Angle+= Dir;	
    
                    ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
                    ObjMove_SetAngle( Shot, Angle );
                        
                    yield;
                        
                }	

                    
                while( !Obj_IsDeleted( Parent ) ){
                        
                    float X_Pos = ObjMove_GetX( Parent ) + Inital_Radius * cos( Angle );
                    float Y_Pos = ObjMove_GetY( Parent ) + Inital_Radius * sin( Angle );					
                        
                    Angle+= Dir;
                    Dir -= Dir/Shrink_Time;		
                        //Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			
                    //Inital_Radius = Interpolate_Overshoot( 0, Radius, 2, i/Time );			
                    Inital_Radius -= ( Radius/2 )/Shrink_Time;	
                    if( Inital_Radius < Radius/2 ){ break; }
                
                    ObjMove_SetPosition( Shot, X_Pos, Y_Pos ); 
                    ObjMove_SetAngle( Shot, Angle );
                        
                    yield;
                        
                }	
                
                //Obj_Delete( Parent );
                Obj_Delete( Shot );
            
            }
                
        }

    }
}	


//-----------------------------------------------------Death---------------------------------------------------------

task T_End {
	
    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
	     yield;
	}
	
	if( ObjEnemyBossScene_GetInfo( GetEnemyBossSceneObjectID, INFO_IS_LAST_STEP ) ){

		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		
		yield;
		
		SetAutoDeleteObject(true);
		T_Boss_Shotdown( bossObj, "Petal", CC_CYAN );
		wait( 200 );
		
		Obj_Delete( bossObj );	
		
		//lol
		ENEMY_CLEAR = true;
		
		yield;
		
		ENEMY_CLEAR = false;
		
		wait( 800 );
		
		CloseScript( GetOwnScriptID() );
		
	}	
	else{
	
		NotifyEventAll( EV_SPAWN_ITEM_NON, bossX, bossY, 38, 64 );	
		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		//DeleteShotAll( TYPE_ALL, TYPE_ITEM );
		
		yield;
		
		SetAutoDeleteObject( true );
		
		Obj_Delete( bossObj );	
		
		wait( 60 );
		
		//DeleteShotAll(TYPE_ALL, TYPE_ITEM);
		
		CloseScript( GetOwnScriptID() );
	
	}
	
	//SetAutoDeleteObject(true);
	
	//Obj_Delete( bossObj );	
	//CloseScript( GetOwnScriptID() );
	
}

