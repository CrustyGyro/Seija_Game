#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Nina_Spell_08"]
#Background["./Stage/STG_05/FW_Stage_5.dnh"];
#Player[ "./Player/PL_Reimu.dnh" ]
#System["./System/System_Main_Hud.dnh"]

//--------------------------------------------------Variables------------------------------------------------------

let bossObj;
let objScene = GetEnemyBossSceneObjectID();
let bossX = 0;
let bossY = 0;

//SetIntersectionVisualization( true );
let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/FW_Boss_EX.png";

//---------------------------------------------------Include-------------------------------------------------------

	#include "./lib/Index_Boss.dnh"
	#include "./lib/Lib_Spell.dnh"
	#include "./lib/Lib_SpellCutin.dnh"

//----------------------------------------------------Start--------------------------------------------------------

@Loading {
	
    LoadTexture( CutinTex );

}


@Initialize {

	bossObj = ObjEnemy_Create(OBJ_ENEMY_BOSS);	
	
	ObjEnemy_Regist( bossObj );	

	T_Lifebar( bossObj );
	T_HitEffect( bossObj );
	ObjEnemy_SetDamageRate( bossObj, 0, 0 );	

	Init_Boss_Nina( bossObj );
	
	ObjMove_SetDestAtWeight( bossObj, GetStgFrameWidth/2, GetStgFrameHeight/2, 15, 8 );
	
	//SetPlayerLife( 8 );
	T_Main;
	T_End;
	
}

@Event { 

	alternative(GetEventType()) 
	case( EV_REQUEST_LIFE ) { 
		SetScriptResult( 1000 ); // 3000-4500 For Nons ( At 100% Damage Rate. )
	}
	case( EV_REQUEST_TIMER ) { 
		//SetScriptResult( 50 );
		SetScriptResult( 50 );
	}	
	case( EV_REQUEST_SPELL_SCORE ){
       SetScriptResult( 9500000 );
    }	

} 

@MainLoop {

	bossX = ObjMove_GetX( bossObj );
	bossY = ObjMove_GetY( bossObj );
	
	SetCommonData( "Effect_X", bossX );
	SetCommonData( "Effect_Y", bossY );	

	ObjEnemy_SetIntersectionCircleToShot( bossObj, bossX, bossY, 16 );
	ObjEnemy_SetIntersectionCircleToPlayer( bossObj, bossX, bossY, 8 );
	
	yield;
}

@Finalize {
} 


task T_InitSpell(){
	
	//let CutinTex = GetCurrentScriptDirectory() ~ "./Resource/Textures/Boss/Cutin/CurseOfRa.png";
	
	T_CallSpell_A1( "\"Truth: Blasted Hills of Armageddon\"", 0, "Normal", objScene );
	T_Call_Spell_Cutin( CutinTex, [ 0, 0, 450, 480 ], 0.8, CC_PINK );	
	
	ObjEnemyBossScene_StartSpell( objScene );
	
	yield;
	T_SpellBG_Nina();
	
}	


//----------------------------------------------------Patterns--------------------------------------------------------


task T_Main {


	//NotifyEventAll( EV_BOSS_EFFECT, bossObj, CC_CYAN );

	yield;

	wait( 45 );	

	T_PlaySE( SE_CHARGE_00, 30 );
	T_Charge_A1( bossObj, 20, "Petal", CC_PINK );

	wait( 30 );	    

    T_InitSpell();
	//T_Create_Pillar( GetStgFrameWidth(), GetStgFrameHeight(), 0, -96, 96, 0 );
	
	//T_PlaySE( SE_CHARGE_00, 30 );
	//T_Charge_A1( bossObj, 20, "Petal", CC_PINK );

	wait( 120 );	

    

	T_Big_Laser( bossX, bossY );
	
	ObjEnemy_SetDamageRate( bossObj, 0.12, 0.12 );
    /*
	while( Boss_Is_Alive( bossObj ) ){

        float Angle_RNG = rand( -12, 12 );
		
  
        ascent (i in 0..10) {
            T_Create_Meteor( 0 + i * GetStgFrameWidth()/9, 0, 90 ); 

            //wait( 1 );
        }
		wait( 120 );	        	

	}
    */
}	

task T_Big_Laser( X, Y ){

    let Laser_Start = ShotR1( bossX, bossY, 0, 0, 90, SHOT_ORB_RED, 10, SHOT_ORB_RED );
    let Laser_End = ShotR1( X, GetStgFrameHeight, 0, 0, 90, SHOT_ORB_RED, 10, SHOT_ORB_RED );
    T_Manage_Laser( Laser_Start, Laser_End );

    //ObjMove_SetDestAtFrame( bossObj, X - 64, GetStgFrameHeight/8, 120, LERP_SMOOTHER );
    
    async{

        float Angle = 0;

        while( !Obj_IsDeleted( bossObj ) ){
                        
            float X_Pos = ObjMove_GetX( bossObj ) + 512 * cos( Angle );
            float Y_Pos = ObjMove_GetY( bossObj ) + 512 * sin( Angle );					
                        
            Angle+= 0.4;
            //Dir -= Dir/Shrink_Time;		
                    //Angle = Interpolate_Overshoot( Angle_Init, Init_Angle, 2, i/60 );			

            ObjMove_SetPosition( Laser_End, X_Pos, Y_Pos ); 
            ObjMove_SetAngle( Laser_End, Angle );
                        
            yield;
                        
        }
    }
    

    async{
        loop{

            ascent (a in 0..3) {
                ascent (i in 0..8) {
                    // do something
                    let Dude_Shot = ShotR1( 0, 0 + i * GetStgFrameHeight()/7, 0, 1, 0, SHOT_MAMIZOU_HUMAN_ORANGE, 1, SHOT_ORB_RED );
                    T_Manage_Collision( Laser_Start, Laser_End, Dude_Shot, rand( -3, -1 ) );

                    let Dude_Shot_B = ShotR1( GetStgFrameWidth, 0 + i * GetStgFrameHeight()/7, 0, 1 , 180, SHOT_MAMIZOU_HUMAN_ORANGE, 1, SHOT_ORB_RED );
                    T_Manage_Collision( Laser_Start, Laser_End, Dude_Shot_B, rand( 1, 3 ) );            

                }

                wait( 30 );
            }
            wait( 120 );

            ascent (a in 0..3) {
                ascent (i in 0..8) {
                    // do something
                    let Dude_Shot = ShotR1( 0, 0 + i * GetStgFrameHeight()/8, 0, 1, 0, SHOT_MAMIZOU_HUMAN_ORANGE, 1, SHOT_ORB_RED );
                    T_Manage_Collision( Laser_Start, Laser_End, Dude_Shot, rand( -3, -1 ) );

                    let Dude_Shot_B = ShotR1( GetStgFrameWidth, 0 + i * GetStgFrameHeight()/8, 0, 1 , 180, SHOT_MAMIZOU_HUMAN_ORANGE, 1, SHOT_ORB_RED );
                    T_Manage_Collision( Laser_Start, Laser_End, Dude_Shot_B, rand( 1, 3 ) );            

                }

                wait( 30 );
            }
            wait( 120 );            
        }


    }


	task T_Manage_Collision( Laser_Start, Laser_End, Shot_Obj, Dir ){
			

		int[] Shot_Bounce_Colors = [ SHOT_BALL_BLUE, SHOT_BALL_YELLOW, SHOT_BALL_RED, SHOT_BALL_RED ];
			
		async{

			//Obj_SetValue( Shot_Obj , "Bounced", false );
 
				//int Bounce_Colors = 0;
				//ObjShot_SetGraphic( Shot_Obj, Shot_Bounce_Colors[ 0 ] );
				
			while( !Obj_IsDeleted( Laser_Start ) ){
					
				let Intersection = IsIntersected_Point_Line( ObjMove_GetX( Shot_Obj ), ObjMove_GetY( Shot_Obj ),  ObjMove_GetX( Laser_Start ), ObjMove_GetY( Laser_Start ), ObjMove_GetX( Laser_End ), ObjMove_GetY( Laser_End ), 32  );			

				if( Intersection == true ){ 
					
					//Bounce_Count -= 1;
					//Obj_SetValue( Shot_Obj, "Bounced", true );
					ObjMove_AddPatternA2( Shot_Obj, 1, 0, GetAngleToPlayer( Shot_Obj ), 0.05, 8 , 0 );
                    //ObjMove_SetSpeed( Shot_Obj, -ObjMove_GetSpeed( Shot_Obj ) + rand( -1, 1 ) );
                    //ObjMove_AddPatternB2( Shot_Obj, 1, NO_CHANGE, rand( -3, -1 ), NO_CHANGE, 0.05, NO_CHANGE, rand( 1.2, 3.2 ) );
					T_DeleteShot_Effect( Shot_Obj );
					//ObjShot_SetGraphic( Shot_Obj, SHOT_BALL_AURA_DAQUA );

					wait( 1 );
					break;
					
				}	

				yield;
			}	

            int Shot_Fire = ShotR1( ObjMove_GetX( Shot_Obj ), ObjMove_GetY( Shot_Obj ), 16, 0, 90, SHOT_SEIJA_FIREBALL_RED, 0, SHOT_SEIJA_FIREBALL_RED );
            //int Shot_Fire_Aimed = ShotR1( ObjMove_GetX( Shot_Obj ), ObjMove_GetY( Shot_Obj ), 16, 1, GetAngleToPlayer( Shot_Obj ), SHOT_SEIJA_FIREBALL_RED, 0, SHOT_SEIJA_FIREBALL_RED );
            //ObjRender_SetScaleXYZ( Shot_Fire, 0.8, 0.8, 0.8 );

            /*
            ascent (i in 0..16) {
                int Shot_Explosion = ShotR1( ObjMove_GetX( Shot_Obj ), ObjMove_GetY( Shot_Obj ), 16, 2, 90 + i * 360/16, SHOT_DROP_INVERT_RED, 8, SHOT_DROP_INVERT_RED );
                ObjMove_AddPatternA2( Shot_Explosion, 1, NO_CHANGE, NO_CHANGE, -0.03, 0, 0 );
                //ObjShot_SetDeleteFrame( Shot_Explosion, 10 );
                ObjMove_AddPatternA2( Shot_Explosion, 60, NO_CHANGE, NO_CHANGE, 0.03, 2, 0 );
            }        
            */    

            ObjRender_SetColor( Shot_Obj, 12, 0, 0 );

            while( !Obj_IsDeleted( Shot_Obj ) ){

                ObjMove_SetPosition( Shot_Fire, ObjMove_GetX( Shot_Obj ), ObjMove_GetY( Shot_Obj ) );
               // ObjRender_SetAngleZ( Shot_Fire, ObjRender_GetAngleZ( Shot_Obj ) + Dir );

                //ObjRender_SetAngleZ( Shot_Obj, ObjRender_GetAngleZ( Shot_Obj ) + Dir );

                yield;

            } 	

            Obj_Delete( Shot_Fire );			
				
		}			
			
			
	}	    

    task T_Manage_Laser( Start, End  ){

		float Time = 120;

		async{

            float Frame = 0;

			let Connector = CreateStraightLaserA1(  ObjMove_GetX( Start ), ObjMove_GetY( Start ), 0, 0, 24, 99999, SHOT_LASER_RED, 10 ); 
            ObjStLaser_SetPermitExpand( Connector, false );
			ObjShot_SetSpellResist( Start, true );
			ObjShot_SetAutoDelete( Start, false );	

			ObjShot_SetSpellResist( End, true );
			ObjShot_SetAutoDelete( End, false );			

			ObjShot_SetAutoDelete( Connector, false );	

			while( !Obj_IsDeleted( Start ) || !Obj_IsDeleted( End ) ){

				if( Obj_IsDeleted( End ) ){ break; }
				if( Obj_IsDeleted( Start ) ){ break; }
				
				//ObjMove_SetPosition( Prifma_Connector, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 
				//ObjStLaser_SetAngle( Prifma_Connector, dottheta( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), bossX, bossY ) );
				//ObjLaser_SetLength( Prifma_Connector, distance( ObjMove_GetX( Shot ), ObjMove_GetY( Shot ), bossX, bossY ) + 1 );							
							
				//ObjMove_SetPosition( Prism, ObjMove_GetX( Shot ), ObjMove_GetY( Shot ) ); 		
                ObjMove_SetPosition( Start, bossX, bossY ); 	
               // ObjMove_SetPosition( End, bossX + 45 * sin( Frame ), ObjMove_GetY( End ) ); 	
				ObjMove_SetPosition( Connector, ObjMove_GetX( Start ), ObjMove_GetY( Start ) ); 
				ObjStLaser_SetAngle( Connector, dottheta( ObjMove_GetX( Start ), ObjMove_GetY( Start ), ObjMove_GetX( End ), ObjMove_GetY( End ) ) );
				ObjLaser_SetLength( Connector, distance( ObjMove_GetX( Start ), ObjMove_GetY( Start ), ObjMove_GetX( End ), ObjMove_GetY( End ) ) + 1 );	

                Frame ++;
				yield;
			}

			Obj_Delete( Connector );			

		}    

    }
} 

task T_Create_Meteor( X, Y, Angle ) {

	let Meteor_Obj = ShotR1( X, Y, 0, 2, Angle, SHOT_SEIJA_FIREBALL_RED, 20, SHOT_ORB_RED );
    ObjMove_AddPatternA2( Meteor_Obj, 20, 0, Angle, 0.03, 4, 0 );
    T_BulletTrail( Meteor_Obj, CC_ORANGE, 3, SHOT_ORB_RED, 0.3 );

    /*
    async{

        while( !Obj_IsDeleted( Meteor_Obj )){

            ObjMove_AddPatternA2( Meteor_Obj, 0, 2, Angle + 45, -0.02, 0, 0 );    
            wait( 120 );
            ObjMove_AddPatternA2( Meteor_Obj, 0, 2, Angle - 45, -0.02, 0, 0 );              
            wait( 120 );

            yield;

        }

    }
    */
    
    async{
        
        while( !Obj_IsDeleted( Meteor_Obj )){

            if( ObjMove_GetY( Meteor_Obj ) >= GetStgFrameHeight() ){ 
                
                ascent (i in 0..16) {
                    int Shot_Explosion = ShotR1( ObjMove_GetX( Meteor_Obj ), ObjMove_GetY( Meteor_Obj ), 16, 2, 90 + i * 360/16, SHOT_SCALE_RED, 8, SHOT_ORB_RED );
                    ObjMove_AddPatternA2( Shot_Explosion, 1, NO_CHANGE, NO_CHANGE, -0.03, 0, 0 );
                    ObjShot_SetDeleteFrame( Shot_Explosion, 10 );
                    //ObjMove_AddPatternA2( Shot_Explosion, 60, NO_CHANGE, NO_CHANGE, 0.03, 2, 0 );
                }
                             
                break;
            }


            yield;
        }


    }

    async{

        wait( 16 );

        while( !Obj_IsDeleted( Meteor_Obj )){

            int Shot_Trail = ShotR1( ObjMove_GetX( Meteor_Obj ), ObjMove_GetY( Meteor_Obj ), 16, 1, ObjMove_GetAngle( Meteor_Obj ) + 90, SHOT_FIREBALL_ORANGE, 4, SHOT_DROP_RED );
            int Shot_Trail_B = ShotR1( ObjMove_GetX( Meteor_Obj ), ObjMove_GetY( Meteor_Obj ), 16, 1, ObjMove_GetAngle( Meteor_Obj ) - 90, SHOT_FIREBALL_ORANGE, 4, SHOT_DROP_RED );
            //ObjShot_SetDeleteFrame( Shot_Trail, 20 );
            ObjMove_AddPatternA2( Shot_Trail, 1, 0, NO_CHANGE, 0.03, 3, 0 );
            ObjMove_AddPatternA2( Shot_Trail_B, 1, 0, NO_CHANGE, 0.03, 3, 0 );

            wait( 24 );
        }


    }    

	task T_BulletTrail( Obj, Color, Rate, Graphic, Size ){

		while( !Obj_IsDeleted( Obj )){

			//int Shot_Name_A = ShotR1( ObjMove_GetX(Obj), ObjMove_GetY(Obj), 0, 1,  ObjMove_GetAngle(Obj) + 180 + rand( -32, 32 ), SHOT_BALL_PURPLE, 0, SHOT_BALL_PURPLE );
			//ObjRender_SetBlendType( Shot_Name_A, BLEND_ADD_ARGB );
			//ObjRender_SetColor( Shot_Name_A, 255, 255, 255 );
			//ObjShot_SetDeleteFrame( Shot_Name_A, 1 );

			int Shot_Name_B = ShotR1( ObjMove_GetX(Obj), ObjMove_GetY(Obj), 0, 1,  ObjMove_GetAngle(Obj) + 180 + rand( -32, 32 ), Graphic, 0, Graphic );
			ObjRender_SetBlendType( Shot_Name_B, BLEND_ADD_ARGB );
			ObjRender_SetColor( Shot_Name_B, Color[0], Color[1], Color[2] );
			T_ManageTrail_Obj( Shot_Name_B );
			ObjShot_SetDeleteFrame( Shot_Name_B, 1 );	
			ObjShot_SetIntersectionEnable( Shot_Name_B, false );

			wait( Rate );
		}

		task T_ManageTrail_Obj( Trail_Shot ){

			ascent (i in 0..20) {
				
				ObjRender_SetScaleXYZ( Trail_Shot, Size - i * Size/20, Size - i * Size/20, Size - i * Size/20 );

				yield;
			}

		}


	}	

}	

//-----------------------------------------------------Death---------------------------------------------------------

task T_End {
	
    while( ObjEnemy_GetInfo( bossObj, INFO_LIFE ) > 0 ) {
	     yield;
	}
	
	if( ObjEnemyBossScene_GetInfo( GetEnemyBossSceneObjectID, INFO_IS_LAST_STEP ) ){

		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		
		yield;
		
		SetAutoDeleteObject(true);
		T_Boss_Shotdown( bossObj, "Petal", CC_CYAN );
		wait( 200 );
		
		Obj_Delete( bossObj );	
		
		//lol
		ENEMY_CLEAR = true;
		
		yield;
		
		ENEMY_CLEAR = false;
		
		wait( 800 );
		
		CloseScript( GetOwnScriptID() );
		
	}	
	else{
	
		NotifyEventAll( EV_SPAWN_ITEM_NON, bossX, bossY, 38, 64 );	
		NotifyEventAll( EV_CLEAR_ENEMY_SHOTS, GetPlayerObjectID(), 60, 12 );
		//DeleteShotAll( TYPE_ALL, TYPE_ITEM );
		
		yield;
		
		SetAutoDeleteObject( true );
		
		Obj_Delete( bossObj );	
		
		wait( 60 );
		
		//DeleteShotAll(TYPE_ALL, TYPE_ITEM);
		
		CloseScript( GetOwnScriptID() );
	
	}
	
	//SetAutoDeleteObject(true);
	
	//Obj_Delete( bossObj );	
	//CloseScript( GetOwnScriptID() );
	
}

