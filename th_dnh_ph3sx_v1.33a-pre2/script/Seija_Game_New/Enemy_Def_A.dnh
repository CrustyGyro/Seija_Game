//-----------------------------------------------------------------------------

task T_Aimed_Fairy_A1( X, Y, Angle, Speed, Wvel, Color, ShotColor ){
			

		int Shotcounter = 0;
			
		let Enemy = Create_Enemy_A1( X, Y, 32, FAIRY_S_NORMAL, Color, 1 );
		ObjMove_AddPatternA2( Enemy, 1, NO_CHANGE ,Angle, 0.1, Speed, Wvel );
		
		float Enemy_X = ObjMove_GetX( Enemy );
		float Enemy_Y = ObjMove_GetY( Enemy );		
		float Frame = 0;
		int Shot_Delay = 60;
		int[] ShotColor_Array = [ SHOT_BALL_ORANGE, SHOT_BALL_DORANGE, SHOT_BALL_YELLOW, SHOT_LARGE_YELLOW ]; 
		
		async{
			while( !Obj_IsDeleted( Enemy ) ){
				
				Enemy_X = ObjMove_GetX( Enemy );
				Enemy_Y = ObjMove_GetY( Enemy );	
					
				Frame++;
				yield;			
				
			}			
		}			
		
		wait( Shot_Delay );
		
		while( !Obj_IsDeleted( Enemy ) && Shotcounter < 3 ){
			
			if( !Obj_IsDeleted( Enemy ) ){
									
				Shotcounter += 1;	
				float Shot_Angle =  GetAngleToPlayer( Enemy );
				
				ascent( i in 0..5 ){	
				
					let Shot_A = ShotR1( Enemy_X + rand( -8, 8 ), Enemy_Y + rand( -8, 8 ), 1, -2, Shot_Angle, ShotColor_Array[ rand_int( 0, 1 ) ], 10, SHOT_CLOUD_ORANGE );
					ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, 0.06, 0, 0 );
					ObjMove_AddPatternA2( Shot_A, 60, NO_CHANGE, NO_CHANGE, 0.06, 4, 0 );
	
					T_PlaySE( SE_SHOT_03, 36 );
				
				
					wait( 3 );
				}
			}		

			wait( 60 );
			yield;
		}
		
	

}

