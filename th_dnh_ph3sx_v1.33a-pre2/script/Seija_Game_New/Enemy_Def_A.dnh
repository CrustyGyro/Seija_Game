task T_Wave2Fairy_A( X, Y, Angle, Speed, Wvel, Color, ShotColor ){
	
	int Shotcounter = 0;
			
	let Enemy = Create_Enemy_A1( X, Y, 32, FAIRY_S_NORMAL, Color, 3 );
	T_Enemy_Aura_A( Enemy, CC_ORANGE, 1.2 );
	
	ObjMove_AddPatternA2( Enemy, 1, Speed, Angle , 0.1, Speed, Wvel );
	ObjMove_AddPatternA2( Enemy, 30, NO_CHANGE, NO_CHANGE , -0.05, 0, Wvel );
	ObjMove_AddPatternA2( Enemy, 120, NO_CHANGE, NO_CHANGE , 0.05, Speed/2, Wvel );
		
	float Enemy_X = ObjMove_GetX( Enemy );
	float Enemy_Y = ObjMove_GetY( Enemy );		
	float Frame = 0;
	int Shot_Delay = 120;
		
	async{
		while( !Obj_IsDeleted( Enemy ) ){
				
			Enemy_X = ObjMove_GetX( Enemy );
			Enemy_Y = ObjMove_GetY( Enemy );	
					
			Frame++;
			yield;			
				
		}			
	}			
	
	wait( Shot_Delay );
	
	while( !Obj_IsDeleted( Enemy ) && Shotcounter < 1 ){
			
		if( !Obj_IsDeleted( Enemy ) ){
								
			Shotcounter += 1;	
			float RNG = rand( -90, 90 );
			
			ascent( i in 0..20 ){
				
				ascent( a in 0..3 ){
					let Shot_A = ShotA2( Enemy_X, Enemy_Y, 1 + a * 0.3/3, -90 + i * 360/20, ShotColor, 10, SHOT_CLOUD_BLUE );
				}
				//ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, 0.01, 0, 0 );
				//ObjMove_AddPatternA2( Shot_A, 60, NO_CHANGE, 90, 0.01, 1 - i * 0.2/4, 0 );
				
				//T_PlaySE( SE_SHOT_03, 40 );
				
				//wait( 4 );
				
			}	
		}		

		wait( 60 );
		yield;
	}

}

