				ascent( i in 0..5 ){	
				
					T_PlaySE( SE_SHOT_03, 36 );
				
					let Shot_A = ShotR1( Enemy_X, Enemy_Y, 8, 1 + i * 3/5, GetAngleToPlayer( Enemy ), SHOT_ICE_OLIVE, 10, SHOT_ICE_OLIVE );
					//ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, -0.1, 0, 0 );
					ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, -0.01, 1 + i * 0.5/5, rand( -0.01, 0.01 ) );		
					//ObjMove_AddPatternA2( Shot_B, 10, NO_CHANGE , NO_CHANGE, 0.08, 8 + i/5, Shot_Way );		
					
