task T_BigFiary_A( X, Y, Angle, Speed, Wvel, Color, ShotColor ){
	
	int Shotcounter = 0;
			
	let Enemy = Create_Enemy_A1( X, Y, 150, YINYANG_S_NORMAL, Color, 1 );
	ObjMove_AddPatternA2( Enemy, 1, Speed, Angle , 0.1, Speed, Wvel );
	ObjMove_AddPatternA2( Enemy, 20, NO_CHANGE, Angle , -0.06, 0, Wvel );	
	ObjMove_AddPatternA2( Enemy, 160, NO_CHANGE, -90, 0.01, 3, rand( -0.1, 0.1 ) );	
		
	float Enemy_X = ObjMove_GetX( Enemy );
	float Enemy_Y = ObjMove_GetY( Enemy );		
	float Frame = 0;
	int Shot_Delay = 120;
	
	float Shot_Angle_A = 90;
	float Shot_Angle_B = 90;
	float Shot_Angle_C = 45;
	float Shot_Count_A = 10;
	float Shot_Count_B = 10;
	
	int Way = 4;
	int Stack = 4;
		
	async{
		while( !Obj_IsDeleted( Enemy ) ){
				
			Enemy_X = ObjMove_GetX( Enemy );
			Enemy_Y = ObjMove_GetY( Enemy );	
					
			Frame++;
			yield;			
				
		}			
	}			
	
	wait( Shot_Delay );
	
	while( !Obj_IsDeleted( Enemy ) && Shotcounter < 24 ){
			
		if( !Obj_IsDeleted( Enemy ) ){
									
			Shotcounter += 1;	
			float Shot_Angle =  GetAngleToPlayer( Enemy );
				
			ascent( a in 0..1 ){	
				ascent( i in 0..1 ){	
					
					let Shot_A = ShotR1( Enemy_X, Enemy_Y, 4, 2, Shot_Angle, ShotColor, 10, SHOT_CLOUD_ORANGE );
					//ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, 0.06, 0, 0 );
					ObjMove_AddPatternA2( Shot_A, 40, NO_CHANGE, NO_CHANGE, -0.06, 1, 0 );
		
					//T_PlaySE( SE_SHOT_03, 36 );
					
					
					//wait( 3 );
				}
			}	
		}		

		wait( 60 );
		yield;
	}	
	
	/*
	while( !Obj_IsDeleted( Enemy ) && Shotcounter < 1 ){
			
		if( !Obj_IsDeleted( Enemy ) ){
								
			Shotcounter += 1;	
			ascent( c in 0..1 ){	
				
				float RNG = 90 + rand( -45, 45 );
				int[] Pattern_Obj = Pattern_Shot_A1( Enemy_X, Enemy_Y, 0.5, 24, 45, 1, ShotColor, PATTERN_POLYGON, Way, Stack, 20, ShotColor );
				
				for( int i = 0; i < Way * Stack; i++ ){
					
					ObjMove_AddPatternA2( Pattern_Obj[i], 30, NO_CHANGE, NO_CHANGE, 0.05, 1 + c * 2/2, 0 );
			
				}				
				//let Shot_A = ShotR1( Enemy_X, Enemy_Y, 16, 1 + a * 1/Shot_Count_A + d *0.4/2, 180 + b * 360/Shot_Count_B + a * Shot_Angle_C/Shot_Count_A, ShotColor, 10, ShotColor );
				
			}
			Shot_Angle_C = -Shot_Angle_C;
		}	
			
		wait( 60 );
	}		
	*/
}


