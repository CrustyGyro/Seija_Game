				Frame++;
				yield;			
				
			}			
			
			let Shot_A = ShotR1( Enemy_X, Enemy_Y, 8, 3, -90, SHOT_LARGE_MINT, 10, SHOT_LARGE_MINT );
			ObjMove_AddPatternA2( Shot_A, 1, NO_CHANGE, NO_CHANGE, -0.1, 0, 0 );
			ObjMove_AddPatternA2( Shot_A, 40, NO_CHANGE, NO_CHANGE, -0.05, -0.8, 0 );
			
		}			
		
		wait( RNG*2 );
		
		/*
