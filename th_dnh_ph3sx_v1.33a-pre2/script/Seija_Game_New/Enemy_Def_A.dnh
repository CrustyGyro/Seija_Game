			if( !Obj_IsDeleted( Enemy ) ){
									
				Shotcounter += 1;	
				
				//let Shot_A = ShotR1( Enemy_X, Enemy_Y, 8, 0, -90, SHOT_ICE_OLIVE, 10, SHOT_ICE_OLIVE );
