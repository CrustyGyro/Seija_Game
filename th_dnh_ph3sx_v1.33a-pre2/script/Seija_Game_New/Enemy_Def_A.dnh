task T_Wave1Fairy_A( X, Y, Angle, Speed, Wvel, Color, ShotColor ){
			
	int Shotcounter = 0;
			
	let Enemy = Create_Enemy_A1( X, Y, 60, FAIRY_S_NORMAL, Color, 1 );
	//T_Enemy_Aura_A( Enemy, CC_PINK, 1.2 );
	ObjMove_AddPatternA2( Enemy, 1, NO_CHANGE, Angle , 0.1, Speed, Wvel );
	ObjMove_AddPatternA2( Enemy, 190, NO_CHANGE, NO_CHANGE, -0.01, 0.5, 0 );
	ObjMove_AddPatternA2( Enemy, 260, NO_CHANGE, 90, 0.05, 1, 0 );
		
	float Enemy_X = ObjMove_GetX( Enemy );
	float Enemy_Y = ObjMove_GetY( Enemy );		
	float Frame = 0;
	int Shot_Delay = 60;
		
	async{
		while( !Obj_IsDeleted( Enemy ) ){
				
			Enemy_X = ObjMove_GetX( Enemy );
			Enemy_Y = ObjMove_GetY( Enemy );	
					
			Frame++;
			yield;			
				
		}			
	}			
	
	wait( Shot_Delay );
		
	while( !Obj_IsDeleted( Enemy ) && Shotcounter < 3 ){
			
		if( !Obj_IsDeleted( Enemy ) ){
								
			Shotcounter += 1;	
			
			//let Shot_A = ShotA2( Enemy_X, Enemy_Y, -1.2, 90, ShotColor, 10, SHOT_CLOUD_BLUE );
			//ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, 0.01, 0, 0 );
			//ObjMove_AddPatternA2( Shot_A, 120, NO_CHANGE, 90 + rand( -10, 10 ), 0.06, 1.2, 0 );
			//	
			T_PlaySE( SE_SHOT_00, 35 );			
			
			
			ascent( i in 0..4 ){
				
				let Shot_A = ShotA2( Enemy_X, Enemy_Y, -1, 90, ShotColor, 10, SHOT_CLOUD_BLUE );
				ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, 0.01, 0, 0 );
				ObjMove_AddPatternA2( Shot_A, 120, NO_CHANGE, 90 + rand( -2, 2 ), 0.01, 1 - i * 0.5/4, 0 );
				
				//T_PlaySE( SE_SHOT_03, 40 );
				
				wait( 8 );
				
			}	
			
		}		

		wait( 40 );
		yield;
	}

}

//-----------------------------------------------------------------------------

task T_Wave1Ghost_Enemy_A( X, Y, Angle, Speed, Wvel, Dir, Color, ShotColor ){
	
	int Shotcounter = 0;
			
	let Enemy = Create_Enemy_A1( X, Y, 100, YINYANG_S_NORMAL, Color, 1 );
	ObjMove_AddPatternA2( Enemy, 1, NO_CHANGE, Angle , 0.1, Speed, Wvel );
		
	float Enemy_X = ObjMove_GetX( Enemy );
	float Enemy_Y = ObjMove_GetY( Enemy );		
	float Frame = 0;
	int Shot_Delay = 60;
		
	async{
		while( !Obj_IsDeleted( Enemy ) ){
				
			Enemy_X = ObjMove_GetX( Enemy );
			Enemy_Y = ObjMove_GetY( Enemy );	
			
			ObjMove_SetX( Enemy, Enemy_X + Dir * cos( Frame*5 ) );
			ObjMove_SetY( Enemy, Enemy_Y + Dir * sin( Frame*5 ) );			
					
			Frame++;
			yield;			
				
		}			
	}			
	
	wait( Shot_Delay );
		
	while( !Obj_IsDeleted( Enemy ) && Shotcounter < 3 ){
			
		if( !Obj_IsDeleted( Enemy ) ){
								
			Shotcounter += 1;	
			float Shot_Angle =  GetAngleToPlayer( Enemy );
				
			ascent( i in 0..5 ){	
				
				let Shot_A = ShotR1( Enemy_X + rand( -8, 8 ), Enemy_Y + rand( -8, 8 ), 1, -2, Shot_Angle, ShotColor, 10, SHOT_CLOUD_ORANGE );
				ObjMove_AddPatternA2( Shot_A, 10, NO_CHANGE, NO_CHANGE, 0.06, 0, 0 );
				ObjMove_AddPatternA2( Shot_A, 60, NO_CHANGE, NO_CHANGE, 0.06, 3, 0 );
				ObjMove_AddPatternA2( Shot_A, 160, NO_CHANGE, NO_CHANGE, -0.06, 0.6, 0 );
	
				T_PlaySE( SE_SHOT_03, 36 );
				
				
				wait( 5 );
			}
		}		

		wait( 60 );
		yield;
	}

}

//-----------------------------------------------------------------------------


task T_BigFiaryA_Enemy_A( X, Y, Angle, Speed, Wvel, Color, ShotColor ){
	
	int Shotcounter = 0;
			
	let Enemy = Create_Enemy_A1( X, Y, 150, FAIRY_M_NORMAL, Color, 1 );
	T_Enemy_Aura_A( Enemy, CC_PINK, 1.2 );
	ObjMove_AddPatternA2( Enemy, 1, NO_CHANGE, Angle , 0.1, Speed, Wvel );
	ObjMove_AddPatternA2( Enemy, 10, NO_CHANGE, Angle , -0.05, Speed/2, Wvel );
		
	float Enemy_X = ObjMove_GetX( Enemy );
	float Enemy_Y = ObjMove_GetY( Enemy );		
	float Frame = 0;
	int Shot_Delay = 60;
	
	float Shot_Angle_A = 90;
	float Shot_Angle_B = 90;
	float Shot_Angle_C = 45;
	float Shot_Count_A = 10;
	float Shot_Count_B = 10;
		
	async{
		while( !Obj_IsDeleted( Enemy ) ){
				
			Enemy_X = ObjMove_GetX( Enemy );
			Enemy_Y = ObjMove_GetY( Enemy );	
					
			Frame++;
			yield;			
				
		}			
	}			
	
	wait( Shot_Delay );
		
	while( !Obj_IsDeleted( Enemy ) && Shotcounter < 2 ){
			
		if( !Obj_IsDeleted( Enemy ) ){
								
			Shotcounter += 1;	
			ascent( c in 0..2 ){	
				ascent( d in 0..2 ){
					ascent( a in 0..Shot_Count_A ){	
						ascent( b in 0..Shot_Count_B ){	
							let Shot_A = ShotR1( Enemy_X, Enemy_Y, 8 + a * 1/Shot_Count_A, 1 + a * 1/Shot_Count_A + d *0.4/2, 180 + b * 360/Shot_Count_B + a * Shot_Angle_C/Shot_Count_A, ShotColor, 10, ShotColor );
				
							//ObjMove_AddPatternA2( Shot_A, 0, NO_CHANGE, NO_CHANGE, -0.1, 0, 0 );
							//ObjMove_AddPatternA2( Shot_A, 1, 1, ObjMove_GetAngle( Shot_A ) + a * Shot_Angle_C/Shot_Count_A, -0.05, 1 + a * 1/Shot_Count_A, 0 );
							//ObjMove_AddPatternA2( Shot_A, 80, 1 + a* 1/Shot_Count_A, ObjMove_GetAngle( Shot_A ) + a * Shot_Angle_C/Shot_Count_A, -0.05, 1 + a* 0.5/Shot_Count_A, 0 );
							//ObjMove_AddPatternA2( Shot_A, 120, NO_CHANGE, NO_CHANGE, -0.01, 1 - a * 0.4/Shot_Count_A, 0 );
							Shot_Angle_A = -Shot_Angle_A;		
							//T_PlaySE( SE_SHOT_03, 40 );
						}
						
						//wait( 5 );
					}
				}
				Shot_Angle_C = -Shot_Angle_C;
			}	
		}		

		wait( 120 );
		yield;
	}

}

